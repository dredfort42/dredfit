    "life.squat" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vom Boden oder vom Stuhl aufstehen, die Treppe hochlaufen – Kraft, die du jeden Tag brauchst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Getting up from the floor or a chair, taking stairs at a run — strength you use every day."
