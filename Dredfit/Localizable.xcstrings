    },
    "Adjust by exercise" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustar por ejercicio"
          }
        },
        "pt-BR" : {
