    "cooldown.restPose": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhehaltung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rest pose"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Postura de descanso"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posture de repos"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Posizione di riposo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Postura de descanso"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поза отдыха"
          }
        }
      }
    },
    "cooldown.restPose.step1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Knie am Boden, setz dich zurück auf die Fersen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Knees on the floor, sit back onto the heels."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rodillas en el suelo, siéntate sobre los talones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Genoux au sol, assieds-toi sur les talons."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginocchia a terra, siediti sui talloni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Joelhos no chão, sente-se sobre os calcanhares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Колени на полу, опусти таз на пятки."
          }
        }
      }
    },
    "cooldown.restPose.step2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beug dich nach vorn, Arme ausgestreckt, Stirn zum Boden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fold forward, arms stretched ahead, forehead down."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclínate hacia adelante, brazos estirados y la frente en el suelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Penche-toi en avant, bras tendus devant, front au sol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Piegati in avanti, braccia distese davanti, fronte a terra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Incline-se à frente, braços esticados e testa no chão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наклонись вперед, вытяни руки, лоб на пол."
          }
        }
      }
    },
    "cooldown.restPose.step3": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Atme langsam und lenk den Atem in den Rücken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Breathe slowly, sending the breath into the back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Respira lento, llevando el aire hacia la espalda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Respire lentement, en envoyant le souffle dans le dos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Respira lentamente, portando il respiro nella schiena."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Respire devagar, levando o ar para as costas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дыши медленно, направляя вдох в спину."
          }
        }
      }
    },
    "cooldown.seatedGlute": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesäßdehnung im Sitzen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seated glute stretch"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Glúteo sentado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fessiers assis"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gluteo da seduti"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Glúteo sentado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ягодичная сидя"
          }
        }
      }
    },
    "cooldown.seatedGlute.step1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setz dich aufrecht hin; leg einen Knöchel auf das andere Knie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit tall; place one ankle over the opposite knee."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siéntate con la espalda recta; apoya un tobillo sobre la rodilla contraria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assieds-toi le dos droit ; pose une cheville sur le genou opposé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Siediti con la schiena dritta; appoggia una caviglia sul ginocchio opposto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sente-se com as costas retas; apoie um tornozelo sobre o joelho oposto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сядь ровно; положи лодыжку на противоположное колено."
          }
        }
      }
    },
    "cooldown.seatedGlute.step2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beug dich mit geradem Rücken aus der Hüfte nach vorn, bis es im Gesäß zieht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lean forward from the hips with a straight back until the glute stretches."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclínate hacia adelante desde la cadera con la espalda recta hasta sentir el glúteo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Penche-toi en avant depuis les hanches, dos droit, jusqu’à sentir l’étirement dans le fessier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Piegati in avanti a partire dalle anche, schiena dritta, fino a sentire tirare il gluteo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Incline-se à frente a partir do quadril com as costas retas até sentir o glúteo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наклонись вперед от таза с прямой спиной — до растяжения в ягодице."
          }
        }
      }
    },
    "cooldown.seatedGlute.step3": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Knie sinkt von allein zur Seite – drück es nicht nach unten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The knee falls open on its own — don't press it down."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La rodilla cae abierta sola: no la presiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le genou s’ouvre tout seul — n’appuie pas dessus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ginocchio si apre da solo – non spingerlo verso il basso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O joelho abre naturalmente: não o pressione."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Колено свободно смотрит в сторону — не дави на него."
          }
        }
      }
    },
    "cooldown.skip": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abwärmen überspringen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip cool-down"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Omitir enfriamiento"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passer le retour au calme"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta il defaticamento"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pular o desaquecimento"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропустить заминку"
          }
        }
      }
    },
    "cooldown.wrists": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Handgelenke und Unterarme"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrists and forearms"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muñecas y antebrazos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poignets et avant-bras"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Polsi e avambracci"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Punhos e antebraços"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запястья и предплечья"
          }
        }
      }
    },
    "cooldown.wrists.step1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arm gestreckt, Handfläche nach unten; zieh die Finger sanft nach unten und zu dir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arm straight, palm down; gently pull the fingers down and toward you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Brazo recto, palma hacia abajo; con la otra mano tira suave de los dedos hacia abajo y hacia ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bras tendu, paume vers le sol ; tire doucement les doigts vers le bas et vers toi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Braccio teso, palmo in giù; con l’altra mano tira piano le dita verso il basso e verso di te."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Braço reto, palma para baixo; com a outra mão puxe de leve os dedos para baixo e na sua direção."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рука прямая, ладонь вниз; другой рукой мягко потяни пальцы вниз и на себя."
          }
        }
      }
    },
    "cooldown.wrists.step2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dann dreh die Handfläche nach oben und zieh wieder sanft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Then turn the palm up and repeat the gentle pull."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Luego gira la palma hacia arriba y repite el estiramiento suave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tourne ensuite la paume vers le haut et tire à nouveau doucement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poi gira il palmo verso l’alto e tira di nuovo, piano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois vire a palma para cima e repita, puxando de leve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Затем разверни ладонь вверх и так же мягко потяни пальцы."
          }
        }
      }
    },
    "cooldown.wrists.step3": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh nur bis zur Dehnung – wenn es sticht oder kribbelt, lass locker."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull only to a stretch — ease off at anything sharp or tingling."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tira solo hasta estirar: si sientes punzadas u hormigueo, afloja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tire seulement jusqu’à l’étirement — si ça pique ou fourmille, relâche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tira solo fino a sentire l’allungamento – se qualcosa punge o formicola, allenta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Puxe só até alongar: se sentir pontada ou formigamento, alivie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тяни только до натяжения — при резкой боли или покалывании ослабь."
          }
        }
      }
    },
    "Couldn't read this file.": {
