    "Used only to estimate the calories of each workout. It stays on this device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dient nur dazu, die Kalorien jedes Trainings zu schätzen. Bleibt auf diesem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se usa para estimar las calorías de cada entrenamiento. No sale de este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sert uniquement à estimer les calories de chaque séance. Reste sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve solo a stimare le calorie di ogni allenamento. Resta su questo dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado apenas para estimar as calorias de cada treino. Fica neste dispositivo."
          }
