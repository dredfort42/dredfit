        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allenarsi a casa. Niente questionari."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Treinar em casa. Sem questionários."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренировки дома. Без анкет."
          }
        }
      }
    },
    "Turn it on if an Apple Watch records the same workouts — otherwise the session counts twice — or if you simply want no estimate written.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere es, wenn eine Apple Watch dieselben Trainings aufzeichnet — sonst zählt die Einheit doppelt — oder wenn du einfach keine Schätzung geschrieben haben willst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actívalo si un Apple Watch registra los mismos entrenamientos — así la sesión no se cuenta dos veces — o si simplemente no quieres que se escriba ninguna estimación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active-le si une Apple Watch enregistre les mêmes séances — sinon la séance compte deux fois — ou si tu préfères qu’aucune estimation ne soit écrite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivalo se un Apple Watch registra gli stessi allenamenti — altrimenti la sessione conta due volte — o se semplicemente non vuoi che venga scritta alcuna stima."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative se um Apple Watch registra os mesmos treinos — assim o treino não conta duas vezes — ou se você simplesmente não quer nenhuma estimativa escrita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включи, если те же тренировки пишет Apple Watch — иначе тренировка засчитается дважды — или если оценка тебе просто не нужна."
          }
        }
      }
    },
    "Unlocked: %@": {
