    "life.override.pull-up": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das eigene Körpergewicht heben – die Grundlage für jede körperliche Aufgabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lifting your own bodyweight — the base for any physical task."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Levantar el peso de tu propio cuerpo — la base para cualquier tarea física."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soulever le poids de ton corps — la base de tout effort physique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sollevare il peso del tuo corpo – la base per qualsiasi sforzo fisico."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Levantar o peso do próprio corpo — a base para qualquer tarefa física."
          }
        },
        "ru": {
