    "plan.techniqueHint": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf eine Bewegung – dort stehen die Technik und die leichtere Variante."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a movement for how it's done — and for the version one step below it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un movimiento: ahí están la técnica y la variación más fácil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche un mouvement : la technique s’y trouve, et la variante plus facile aussi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un movimento: lì trovi la tecnica e la variante più facile."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em um movimento: ali estão a técnica e a variação mais fácil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажми на движение — там техника и вариация полегче."
          }
        }
      }
    },
    "technique.stepDown.confirmTitle": {
