          "stringUnit": {
            "state": "translated",
            "value": "A partir de aquí va solo: el sonido marca el inicio y el final. Deja el teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À partir d’ici, ça se déroule tout seul — le son marque le début et la fin. Pose le téléphone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da qui va da solo – il suono segna l’inizio e la fine. Appoggia il telefono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Daqui em diante corre sozinho: o som marca o início e o fim. Pode largar o telefone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дальше идет само — звук отсчитает вход и выход. Положи телефон."
          }
        }
      }
    },
