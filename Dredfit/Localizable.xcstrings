    "Deload" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entlastung"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allègement"
          }
        },
        "it" : {
