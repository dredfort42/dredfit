    "life.pull_bar" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das eigene Körpergewicht halten und hochziehen – das ehrlichste Maß für Kraft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Holding and pulling your own bodyweight — the most honest measure of strength."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostener y traccionar el peso de tu propio cuerpo — la medida más honesta de la fuerza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenir et tirer le poids de ton corps — la mesure la plus honnête de la force."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reggere il peso del tuo corpo e tirarti su – la misura più onesta della forza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
