    "life.override.push_v-4" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your whole body above your hands — a rare level of control."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo el cuerpo sobre las manos — un nivel de control poco común."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O corpo inteiro sobre as mãos — um nível raro de controle."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все тело над руками — редкий уровень контроля."
          }
        }
      }
    },
    "life.override.squat-3" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standing up from the floor on one leg — no hands, no support."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levantarte del suelo con una sola pierna — sin manos y sin apoyo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levantar do chão com uma perna só — sem as mãos e sem apoio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встать с пола на одной ноге — без рук и без опоры."
          }
        }
      }
    },
    "life.pull" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A straight back and open shoulders after a day at the desk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espalda recta y hombros abiertos después de un día frente al escritorio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Costas retas e ombros abertos depois de um dia sentado à mesa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ровная спина и развернутые плечи после дня за столом."
          }
        }
      }
    },
    "life.pull_bar" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Holding and pulling your own bodyweight — the most honest measure of strength."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostener y levantar el peso de tu propio cuerpo — la medida más honesta de la fuerza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segurar e puxar o peso do próprio corpo — a medida mais honesta da força."
          }
