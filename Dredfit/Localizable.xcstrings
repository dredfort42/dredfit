    "WARM-UP": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AUFWÄRMEN"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CALENTAMIENTO"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ÉCHAUFFEMENT"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "RISCALDAMENTO"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "AQUECIMENTO"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "РАЗМИНКА"
          }
        }
      }
    },
    "warmup.armCircles.step1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreise mit gestreckten Armen nach vorn – große, langsame Kreise."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Circle straight arms forward — big, slow circles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuja círculos grandes y lentos hacia adelante con los brazos rectos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bras tendus, dessine de grands cercles lents vers l’avant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruota le braccia tese in avanti – cerchi ampi e lenti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça círculos grandes e lentos para a frente com os braços esticados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Крути прямыми руками вперед — большие медленные круги."
          }
        }
      }
    },
    "warmup.armCircles.step2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechsle nach der Hälfte die Richtung und kreise rückwärts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Halfway through, switch direction and circle backward."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A mitad de tiempo, cambia de dirección y gira hacia atrás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À mi-parcours, change de sens et fais des cercles vers l’arrière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A metà del tempo, cambia direzione e ruota all’indietro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na metade do tempo, inverta a direção e gire para trás."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На середине смени направление — крути назад."
          }
        }
      }
    },
    "warmup.catCow.step1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Vierfüßlerstand: Atme aus, mach den Rücken rund und zieh das Kinn zur Brust."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On all fours: exhale, round the back and tuck the chin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A cuatro patas: exhala, redondea la espalda y mete la barbilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À quatre pattes : expire, arrondis le dos et rentre le menton."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A quattro zampe: espira, incurva la schiena e porta il mento al petto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De quatro: expire, arredonde as costas e recolha o queixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На четвереньках: на выдохе округли спину и опусти подбородок."
          }
        }
      }
    },
    "warmup.catCow.step2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Atme ein, geh sanft ins Hohlkreuz und schau leicht nach oben – eine langsame Welle pro Atemzug."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inhale, arch gently and look slightly up — one slow wave per breath."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inhala, arquea suave y mira un poco hacia arriba: una onda lenta por respiración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspire, creuse doucement le dos et regarde un peu vers le haut — une vague lente à chaque respiration."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspira, inarca dolcemente e guarda un po’ in alto – un’onda lenta a ogni respiro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspire, arqueie suave e olhe um pouco para cima: uma onda lenta por respiração."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На вдохе мягко прогнись и посмотри чуть вверх — одна медленная волна на цикл дыхания."
          }
        }
      }
    },
    "warmup.halfSquats.step1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setz dich nach hinten in die halbe Kniebeuge, die Arme nach vorn für die Balance."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit back to half depth, arms reaching forward for balance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja hasta media sentadilla llevando la cadera atrás; brazos al frente para equilibrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Descends en demi-squat comme pour t’asseoir, bras tendus devant pour l’équilibre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Porta il bacino indietro e scendi in un mezzo squat; braccia in avanti per l’equilibrio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desça até meio agachamento levando o quadril para trás; braços à frente para equilibrar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Присядь до половины, отводя таз назад; руки вперед для баланса."
          }
        }
      }
    },
    "warmup.halfSquats.step2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fersen bleiben am Boden; komm gleichmäßig hoch, ohne die Knie durchzustrecken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heels stay down; rise smoothly without locking the knees."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Talones en el suelo; sube suave sin bloquear las rodillas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les talons restent au sol ; remonte en douceur sans verrouiller les genoux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Talloni a terra; risali in modo fluido senza bloccare le ginocchia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcanhares no chão; suba suave sem travar os joelhos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пятки на полу; вставай плавно, не выпрямляя колени до замка."
          }
        }
      }
    },
    "warmup.hipCircles.step1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hände in die Hüften, Füße schulterbreit; kreise langsam mit der Hüfte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hands on the hips, feet shoulder-width; draw slow circles with the hips."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Manos en la cadera, pies al ancho de hombros; dibuja círculos lentos con la cadera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mains sur les hanches, pieds à la largeur des épaules ; dessine des cercles lents avec le bassin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mani sui fianchi, piedi alla larghezza delle spalle; disegna cerchi lenti con il bacino."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mãos no quadril, pés na largura dos ombros; desenhe círculos lentos com o quadril."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Руки на пояс, стопы на ширине плеч; рисуй тазом медленные круги."
          }
        }
      }
    },
    "warmup.hipCircles.step2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass die Knie locker und wechsle nach der Hälfte die Richtung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the knees soft and switch direction halfway."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rodillas ligeramente flexionadas; cambia de dirección a mitad de tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde les genoux souples et change de sens à mi-parcours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni le ginocchia morbide e cambia direzione a metà del tempo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Joelhos levemente flexionados; inverta a direção na metade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Колени чуть согнуты; на середине смени направление."
          }
        }
      }
    },
    "warmup.marching.step1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Marschiere in ruhigem Tempo auf der Stelle und heb die Knie auf Hüfthöhe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "March at an easy pace, lifting the knees to hip height."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcha a ritmo suave, subiendo las rodillas a la altura de la cadera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marche sur place à un rythme tranquille, en montant les genoux à hauteur des hanches."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcia sul posto a ritmo tranquillo, portando le ginocchia all’altezza dei fianchi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marche em ritmo tranquilo, subindo os joelhos à altura do quadril."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шагай на месте в спокойном темпе, поднимая колени до уровня таза."
          }
        }
      }
    },
    "warmup.marching.step2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass die Arme frei mitschwingen, die Schultern bleiben locker."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swing the arms freely and keep the shoulders relaxed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve los brazos con soltura y mantén los hombros relajados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balance librement les bras et garde les épaules relâchées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia oscillare le braccia liberamente e tieni le spalle rilassate."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Balance os braços livremente e mantenha os ombros relaxados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свободно работай руками, плечи расслаблены."
          }
        }
      }
    },
    "warmup.torsoRotations.step1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füße fest am Boden, die Hüfte zeigt nach vorn; dreh den Oberkörper von Seite zu Seite."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feet planted, hips facing forward; turn the torso side to side."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pies firmes, cadera al frente; gira el torso de lado a lado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pieds ancrés au sol, hanches vers l’avant ; tourne le buste d’un côté à l’autre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Piedi ben piantati, bacino rivolto in avanti; ruota il busto da un lato all’altro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pés firmes, quadril para a frente; gire o tronco de um lado para o outro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стопы на месте, таз смотрит вперед; поворачивай корпус из стороны в сторону."
          }
        }
      }
    },
    "warmup.torsoRotations.step2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass die Arme locker mitschwingen – Schwung, nicht Kraft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let the arms swing loose — momentum, not force."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja que los brazos acompañen sueltos: impulso, no fuerza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisse les bras se balancer librement — l’élan, pas la force."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia le braccia sciolte, che girino da sole – slancio, non forza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe os braços acompanharem soltos: embalo, não força."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Руки расслаблены и летят за корпусом — инерция, а не усилие."
          }
        }
      }
    },
    "Weekly rhythm": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wochenrhythmus"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekly rhythm"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritmo semanal"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rythme de la semaine"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritmo settimanale"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritmo da semana"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ритм недели"
          }
        }
      }
    },
    "Welcome back": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Willkommen zurück"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Qué bueno tenerte de vuelta!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Te revoilà !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Che bello rivederti"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Que bom te ver de volta"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С возвращением"
          }
        }
      }
    },
    "Went differently": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lief anders"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fue distinto"
          }
        },
        "fr": {
