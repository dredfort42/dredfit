    "Warm-up": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufwärmen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warm-up"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calentamiento"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échauffement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riscaldamento"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquecimento"
          }
        },
        "ru": {
