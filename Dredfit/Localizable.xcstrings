    "life.lunge" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein sicherer Schritt auf der Treppe, bergauf, vom Bordstein – Gleichgewicht unter Last."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A confident step on stairs, uphill, off a curb — balance under load."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un paso seguro en las escaleras, cuesta arriba y al bajar de la acera — equilibrio bajo carga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pas assuré dans l’escalier, en montée, en descendant du trottoir — l’équilibre sous charge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piede sicuro sulle scale, in salita, giù dal marciapiede – equilibrio sotto carico."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um passo firme na escada, na subida e ao descer da calçada — equilíbrio sob carga."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уверенный шаг на лестнице, в горку и с бордюра — равновесие под нагрузкой."
          }
        }
      }
    },
    "life.override.pull_bar-4" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das eigene Körpergewicht heben – die Grundlage für jede körperliche Aufgabe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lifting your own bodyweight — the base for any physical task."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levantar el peso de tu propio cuerpo — la base para cualquier tarea física."
          }
        },
        "fr" : {
