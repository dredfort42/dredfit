        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поднять вес собственного тела — база для любой физической задачи."
          }
        }
      }
    },
    "life.override.push_h-2" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das eigene Körpergewicht – voll unter Kontrolle."
          }
        },
        "en" : {
