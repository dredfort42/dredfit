    "cooldown.wrists" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handgelenke und Unterarme"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wrists and forearms"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muñecas y antebrazos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poignets et avant-bras"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polsi e avambracci"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punhos e antebraços"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запястья и предплечья"
          }
        }
      }
    },
    "cooldown.wrists.step1" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arm gestreckt, Handfläche nach unten; zieh die Finger sanft nach unten und zu dir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arm straight, palm down; gently pull the fingers down and toward you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brazo recto, palma hacia abajo; con la otra mano tira suave de los dedos hacia abajo y hacia ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bras tendu, paume vers le sol ; tire doucement les doigts vers le bas et vers toi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Braccio teso, palmo in giù; con l’altra mano tira piano le dita verso il basso e verso di te."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Braço reto, palma para baixo; com a outra mão puxe de leve os dedos para baixo e na sua direção."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рука прямая, ладонь вниз; другой рукой мягко потяни пальцы вниз и на себя."
          }
        }
      }
    },
    "cooldown.wrists.step2" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dann dreh die Handfläche nach oben und zieh wieder sanft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Then turn the palm up and repeat the gentle pull."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luego gira la palma hacia arriba y repite el estiramiento suave."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tourne ensuite la paume vers le haut et tire à nouveau doucement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poi gira il palmo verso l’alto e tira di nuovo, piano."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois vire a palma para cima e repita, puxando de leve."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Затем разверни ладонь вверх и так же мягко потяни пальцы."
          }
        }
      }
    },
    "cooldown.wrists.step3" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh nur bis zur Dehnung – wenn es sticht oder kribbelt, lass locker."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pull only to a stretch — ease off at anything sharp or tingling."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tira solo hasta estirar: si sientes punzadas u hormigueo, afloja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tire seulement jusqu’à l’étirement — si ça pique ou fourmille, relâche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tira solo fino a sentire l’allungamento – se qualcosa punge o formicola, allenta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puxe só até alongar: se sentir pontada ou formigamento, alivie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тяни только до натяжения — при резкой боли или покалывании ослабь."
          }
        }
      }
    },
