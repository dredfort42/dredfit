    "The movement still counts as trained — the plan keeps those sets off next time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bewegung gilt weiterhin als trainiert — der Plan lässt diese Sätze beim nächsten Mal weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The movement still counts as trained — the plan keeps those sets off next time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El movimiento sigue contando como entrenado: la próxima vez el plan deja fuera esas series."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mouvement compte toujours comme entraîné : la prochaine fois, le programme retire ces séries."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il movimento conta comunque come allenato: la prossima volta il piano toglie quelle serie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O movimento continua contando como treinado — na próxima vez o plano deixa essas séries de fora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Движение все равно считается сделанным — в следующий раз плана на эти подходы не будет."
          }
        }
      }
    },
    "The movement counts as not trained, and any number you entered for it is not kept. Its plan stays exactly as it is.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bewegung gilt als nicht trainiert, und eingegebene Zahlen dazu werden nicht behalten. Ihr Plan bleibt genau so, wie er ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The movement counts as not trained, and any number you entered for it is not kept. Its plan stays exactly as it is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El movimiento cuenta como no entrenado y no se guarda ningún número que hayas introducido para él. Su plan se queda exactamente igual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mouvement compte comme non entraîné, et aucun nombre saisi pour lui n’est conservé. Son programme reste exactement tel quel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il movimento conta come non allenato e nessun numero inserito per esso viene conservato. Il suo piano resta esattamente com’è."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O movimento conta como não treinado, e nenhum número que você tenha inserido para ele é guardado. O plano dele fica exatamente como está."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Движение считается несделанным, и введенные по нему числа не сохранятся. План по нему останется ровно таким же."
          }
        }
      }
    },
