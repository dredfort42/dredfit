    "life.override.push_v-4" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der ganze Körper über den Händen – ein seltenes Maß an Kontrolle."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your whole body above your hands — a rare level of control."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo el cuerpo sobre las manos — un nivel de control poco común."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ton corps au-dessus des mains — une maîtrise rare."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto il corpo sopra le mani – una padronanza rara."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O corpo inteiro sobre as mãos — um nível raro de controle."
