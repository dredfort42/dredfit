        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужен только для оценки калорий каждой тренировки. Остается на этом устройстве."
          }
        }
      }
    },
    "Without it, workouts are saved without calories.": {
      "localizations": {
        "de": {
          "stringUnit": {
