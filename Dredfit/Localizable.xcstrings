          }
        }
      }
    },
    "life.override.squat-3" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf einem Bein vom Boden aufstehen – ohne Hände, ohne Stütze."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standing up from the floor on one leg — no hands, no support."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levantarte del suelo con una sola pierna — sin manos y sin apoyo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se relever du sol sur une jambe — sans les mains, sans appui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alzarsi da terra su una gamba sola – senza mani e senza appoggio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levantar do chão com uma perna só — sem as mãos e sem apoio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встать с пола на одной ноге — без рук и без опоры."
          }
        }
      }
    },
    "life.pull" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein gerader Rücken und offene Schultern nach einem Tag am Schreibtisch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A straight back and open shoulders after a day at the desk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espalda recta y hombros abiertos después de un día frente al escritorio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un dos droit et des épaules ouvertes après une journée au bureau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
