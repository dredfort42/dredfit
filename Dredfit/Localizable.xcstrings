    "life.calf": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Federkraft in jedem Schritt: Treppensteigen und Laufen fühlen sich für Knie und Füße leichter an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spring in every step: stairs and running feel lighter on knees and feet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resorte en cada paso: subir escaleras y correr se siente más liviano para las rodillas y los pies."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Du ressort à chaque pas : les escaliers et la course pèsent moins sur les genoux et les pieds."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gambe a molla: scale e corsa pesano meno su ginocchia e piedi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mola em cada passo: escada e corrida ficam mais leves para os joelhos e os pés."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пружина в каждом шаге: лестница и бег даются легче коленям и стопам."
          }
        }
      }
    },
    "life.core_anti_ext": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein unterer Rücken, der langes Sitzen, Bücken und einen schweren Rucksack wegsteckt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A lower back that handles long hours of sitting, bending and a heavy backpack."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una zona lumbar que aguanta horas en la silla, agacharte y cargar una mochila pesada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rester des heures en position assise, se pencher, porter un sac à dos lourd — un bas du dos qui encaisse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una zona lombare che regge ore da seduti, le volte che ti chini e uno zaino pesante."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma lombar que aguenta horas na cadeira, inclinações e uma mochila pesada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поясница, которая спокойно переносит долгое сидение, наклоны и тяжелый рюкзак."
          }
        }
      }
    },
    "life.core_rot": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewicht in einer Hand tragen, sich zur Seite strecken – ein Rumpf, der hält."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Carrying weight in one hand, reaching sideways — a torso that holds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargar peso con una mano, estirarte hacia el costado — un torso que no cede."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Porter une charge d’une seule main, tendre le bras sur le côté — un buste qui tient."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Portare un peso con una mano, allungarsi di lato – un busto che tiene."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carregar peso em uma mão, se esticar para o lado — um tronco que não cede."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нести тяжесть в одной руке, тянуться вбок — корпус не подводит."
          }
        }
      }
    },
    "life.hinge": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Tasche, ein Kind, einen Koffer heben – aus der Hüfte, nicht aus dem unteren Rücken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lifting a bag, a child, a suitcase — with your hips, not your lower back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Levantar del suelo una bolsa, a un niño, una maleta — con las caderas, no con la zona lumbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soulever un sac, un enfant, une valise — avec les hanches, pas avec le bas du dos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sollevare una borsa, un bambino, una valigia – con le anche, non con la zona lombare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Levantar do chão uma bolsa, uma criança, uma mala — com o quadril, não com a lombar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поднять с пола сумку, ребенка, чемодан — ногами и тазом, а не поясницей."
          }
        }
      }
    },
    "life.kicker": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Alltag"
          }
        },
        "en": {
