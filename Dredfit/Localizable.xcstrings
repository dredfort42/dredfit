    "A maximum now takes the strength out of the sets after it. What counts is the whole exercise, not one set.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A maximum now takes the strength out of the sets after it. What counts is the whole exercise, not one set."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Maximum jetzt nimmt den Sätzen danach die Kraft. Es zählt die ganze Übung, nicht ein einzelner Satz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un máximo ahora le quita fuerza a las series siguientes. Cuenta el ejercicio entero, no una sola serie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un maximum maintenant enlève de la force aux séries suivantes. C’est tout l’exercice qui compte, pas une seule série."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un massimo adesso toglie forza alle serie successive. Conta tutto l’esercizio, non una sola serie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um máximo agora tira força das séries seguintes. Conta o exercício inteiro, não uma série só."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Максимум сейчас заберёт силы у следующих подходов. Считается всё упражнение целиком, а не один подход."
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertig"
          }
        },
        "es": {
