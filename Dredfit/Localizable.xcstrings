    },
    "cooldown.lyingTwist.step1" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf dem Rücken, Knie angewinkelt; lass beide Knie zu einer Seite sinken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On your back, knees bent; drop both knees to one side."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boca arriba, rodillas dobladas; déjalas caer hacia un lado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur le dos, genoux fléchis ; laisse-les tomber d’un côté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pancia in su, ginocchia piegate; lasciale cadere entrambe da un lato."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De costas, joelhos dobrados; deixe-os cair para um lado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лежа на спине, согни колени и опусти их в сторону."
          }
        }
      }
    },
    "cooldown.lyingTwist.step2" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schultern bleiben am Boden, der Kopf dreht sich zur anderen Seite."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shoulders stay on the floor, head turns the other way."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los hombros siguen en el suelo; la cabeza gira hacia el lado contrario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les épaules restent au sol, la tête tourne de l’autre côté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le spalle restano a terra, la testa gira dall’altra parte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os ombros ficam no chão; a cabeça vira para o lado oposto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плечи на полу, голова повернута в другую сторону."
          }
        }
      }
    },
    "cooldown.lyingTwist.step3" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass das Gewicht von allein sinken – drück die Knie nicht nach unten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let the weight sink on its own — don't push the knees down."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja que las rodillas bajen por su propio peso: no las empujes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laisse le poids descendre tout seul — n’appuie pas sur les genoux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia che il peso scenda da solo – non spingere le ginocchia verso il basso."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe o peso afundar sozinho: não empurre os joelhos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дай коленям опускаться под своим весом — не дави на них."
          }
        }
      }
    },
