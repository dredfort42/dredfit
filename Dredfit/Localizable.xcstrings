        }
      }
    },
    "life.calf" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spring in every step: stairs and running feel lighter on knees and feet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resorte en cada paso: subir escaleras y correr se siente más liviano para las rodillas y los pies."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mola em cada passo: escada e corrida ficam mais leves para os joelhos e os pés."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пружина в каждом шаге: лестница и бег даются легче коленям и стопам."
          }
        }
      }
    },
    "life.core_anti_ext" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lower back that handles long hours of sitting, bending and a heavy backpack."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una zona lumbar que aguanta horas sentado, inclinarte y cargar una mochila pesada."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma lombar que aguenta horas sentado, inclinações e uma mochila pesada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поясница, которая спокойно переносит долгое сидение, наклоны и тяжелый рюкзак."
          }
        }
      }
    },
    "life.core_rot" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carrying weight in one hand, reaching sideways — a torso that holds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cargar peso con una mano, estirarte hacia el costado — un torso que no cede."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carregar peso em uma mão, se esticar para o lado — um tronco que não cede."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нести тяжесть в одной руке, тянуться вбок — корпус не подводит."
          }
        }
      }
    },
    "life.hinge" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lifting a bag, a child, a suitcase — with your hips, not your lower back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levantar del suelo una bolsa, a un niño, una maleta — con las caderas, no con la zona lumbar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levantar do chão uma bolsa, uma criança, uma mala — com o quadril, não com a lombar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поднять с пола сумку, ребенка, чемодан — ногами и тазом, а не поясницей."
          }
        }
      }
    },
    "life.kicker" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In life"
          }
        },
        "es" : {
          "stringUnit" : {
