    "Recovery is part of the plan — you get stronger between workouts, not during them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erholung ist Teil des Plans – stärker wirst du zwischen den Trainings, nicht währenddessen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La recuperación es parte del plan: te haces más fuerte entre los entrenamientos, no durante ellos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La récupération fait partie du plan : tu progresses entre les séances, pas pendant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il riposo fa parte del piano – diventi più forte tra un allenamento e l’altro, non durante."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A recuperação faz parte do plano: você fica mais forte entre os treinos, não durante eles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановление — часть плана: сила растёт не на тренировке, а между ними."
          }
        }
      }
    },
