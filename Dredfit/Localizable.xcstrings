    "cooldown.calfWall" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wadendehnung an der Wand"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calf stretch at the wall"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pantorrilla en la pared"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mollets au mur"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polpacci al muro"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panturrilha na parede"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Икры у стены"
          }
        }
      }
    },
    "cooldown.calfWall.step1" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hände an der Wand, ein Bein nach hinten gestellt, Ferse am Boden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hands on the wall, one leg stepped back, heel on the floor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manos en la pared, una pierna atrás con el talón en el suelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mains contre le mur, une jambe en arrière, talon au sol."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mani al muro, una gamba indietro, tallone a terra."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mãos na parede, uma perna atrás com o calcanhar no chão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ладони на стене, одна нога отставлена назад, пятка на полу."
          }
        }
      }
    },
    "cooldown.calfWall.step2" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinteres Knie gestreckt; lehn dich zur Wand, bis es in der Wade zieht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Back knee straight; lean toward the wall until the calf stretches."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rodilla trasera recta; acércate a la pared hasta sentir el estiramiento en la pantorrilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genou arrière tendu ; penche-toi vers le mur jusqu’à sentir l’étirement dans le mollet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ginocchio dietro teso; avvicinati al muro fino a sentire tirare il polpaccio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joelho de trás reto; incline-se para a parede até alongar a panturrilha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заднее колено прямое; подайся к стене — до растяжения икры."
          }
        }
      }
    },
    "cooldown.calfWall.step3" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ferse bleibt unten – nicht wippen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the heel down — no bouncing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El talón no se despega: sin rebotes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde le talon au sol — sans à-coups."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tallone resta a terra – senza molleggiare."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O calcanhar não sai do chão: sem balançar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пятку не отрывай — без пружинящих движений."
          }
        }
      }
    },
    "cooldown.chestWall" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brust und Schultern an der Wand"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chest and shoulders at the wall"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pecho y hombros en la pared"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poitrine et épaules au mur"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Petto e spalle al muro"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peito e ombros na parede"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Грудь и плечи у стены"
          }
        }
      }
    },
    "cooldown.chestWall.step1" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unterarm an der Wand, Ellenbogen auf Schulterhöhe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forearm on the wall, elbow at shoulder height."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antebrazo en la pared, codo a la altura del hombro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avant-bras contre le mur, coude à hauteur d’épaule."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avambraccio al muro, gomito all’altezza della spalla."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antebraço na parede, cotovelo na altura do ombro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предплечье на стене, локоть на уровне плеча."
          }
        }
      }
    },
    "cooldown.chestWall.step2" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dreh die Brust von der Wand weg, bis es vorn in der Schulter zieht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn the chest away from the wall until the front of the shoulder stretches."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira el pecho alejándolo de la pared hasta sentir el estiramiento delante del hombro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tourne le buste à l’opposé du mur jusqu’à sentir l’étirement à l’avant de l’épaule."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruota il petto allontanandolo dal muro fino a sentire tirare davanti alla spalla."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gire o peito para longe da parede até alongar a frente do ombro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разверни грудь от стены — до растяжения передней части плеча."
          }
        }
      }
    },
    "cooldown.chestWall.step3" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schulter tief, weg vom Ohr – dreh dich bis zur Dehnung, nicht bis zum Schmerz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the shoulder down, away from the ear — turn to a stretch, not into pain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hombro abajo, lejos de la oreja: gira hasta estirar, no hasta que duela."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Épaule basse, loin de l’oreille — tourne jusqu’à l’étirement, pas jusqu’à la douleur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spalla bassa, lontana dall’orecchio – ruota fino a sentire tirare, non fino al dolore."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ombro baixo, longe da orelha: gire até alongar, não até doer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плечо вниз, подальше от уха — разворачивайся до натяжения, не до боли."
          }
        }
      }
    },
    "cooldown.forwardFold" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorbeuge"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forward fold"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexión hacia adelante"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexion avant"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piegamento in avanti"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexão à frente"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наклон вперед стоя"
          }
        }
      }
    },
    "cooldown.forwardFold.step1" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füße hüftbreit; beug dich aus der Hüfte nach vorn, Knie locker."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feet hip-width; fold forward from the hips, knees soft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pies al ancho de cadera; inclínate desde la cadera con las rodillas ligeramente flexionadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pieds largeur du bassin ; penche-toi en avant depuis les hanches, genoux souples."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piedi alla larghezza dei fianchi; piegati in avanti a partire dalle anche, ginocchia morbide."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pés na largura do quadril; dobre o tronco a partir do quadril, joelhos levemente flexionados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стопы на ширине таза; наклонись вперед от таза, колени чуть согнуты."
          }
        }
      }
    },
    "cooldown.forwardFold.step2" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass Kopf und Arme schwer hängen – streck dich nicht zum Boden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let the head and arms hang heavy — no reaching for the floor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja colgar la cabeza y los brazos: no fuerces hasta el suelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laisse pendre la tête et les bras — ne cherche pas à toucher le sol."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia che testa e braccia pendano pesanti – non cercare di toccare terra."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe a cabeça e os braços pendurados: não force até o chão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Голова и руки свободно висят — не тянись к полу."
          }
        }
      }
    },
    "cooldown.forwardFold.step3" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roll dich langsam wieder auf, Wirbel für Wirbel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To come up, unroll the spine slowly, one vertebra at a time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para subir, desenrolla la espalda despacio, vértebra a vértebra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour remonter, déroule lentement la colonne, vertèbre par vertèbre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per risalire, srotola lentamente la schiena, una vertebra alla volta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para subir, desenrole as costas devagar, vértebra por vértebra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поднимайся медленно, раскручивая спину позвонок за позвонком."
          }
        }
      }
    },
    "cooldown.hipFlexors" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hüftbeuger dehnen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hip flexor stretch"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexores de cadera"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fléchisseurs de hanche"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flessori dell’anca"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexores do quadril"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сгибатели бедра"
          }
        }
      }
    },
    "cooldown.hipFlexors.step1" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geh auf ein Knie, der andere Fuß steht vorn."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kneel on one knee, the other foot planted in front."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apoya una rodilla en el suelo, con el otro pie plantado delante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pose un genou au sol, l’autre pied à plat devant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metti un ginocchio a terra, l’altro piede ben piantato davanti."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apoie um joelho no chão, com o outro pé firme à frente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опустись на одно колено, другая стопа стоит впереди."
          }
        }
      }
    },
    "cooldown.hipFlexors.step2" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richte das Becken auf und schieb es leicht nach vorn, bis es vorn in der Hüfte zieht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuck the pelvis and shift it slightly forward until the front of the hip stretches."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bascula la pelvis y llévala un poco hacia adelante hasta sentir el estiramiento delante de la cadera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bascule le bassin et avance-le légèrement jusqu’à sentir l’étirement à l’avant de la hanche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bascula il bacino e spostalo leggermente in avanti, fino a sentire tirare davanti all’anca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encaixe a pelve e leve-a um pouco à frente até sentir alongar a frente do quadril."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подкрути таз и подай его чуть вперед — до растяжения по передней поверхности бедра."
          }
        }
      }
    },
    "cooldown.hipFlexors.step3" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte die Position und atme – nicht wippen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold steady and breathe — no bouncing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén la posición y respira: sin rebotes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiens la position et respire — sans à-coups."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni la posizione e respira – senza molleggiare."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha a posição e respire: sem balançar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Держи положение и дыши — без пружинящих движений."
          }
        }
      }
    },
    "cooldown.latStretch" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
