    "life.lunge": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein sicherer Schritt auf der Treppe, bergauf, vom Bordstein – Gleichgewicht unter Last."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A confident step on stairs, uphill, off a curb — balance under load."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un paso seguro en las escaleras, cuesta arriba y al bajar de la acera — equilibrio bajo carga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pas assuré dans l’escalier, en montée, en descendant du trottoir — l’équilibre sous charge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Piede sicuro sulle scale, in salita, giù dal marciapiede – equilibrio sotto carico."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um passo firme na escada, na subida e ao descer da calçada — equilíbrio sob carga."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уверенный шаг на лестнице, в горку и с бордюра — равновесие под нагрузкой."
          }
        }
      }
    },
    "life.pull": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein gerader Rücken und offene Schultern nach einem Tag am Schreibtisch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A straight back and open shoulders after a day at the desk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espalda recta y hombros abiertos después de un día frente al escritorio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dos droit et des épaules ouvertes après une journée au bureau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Schiena dritta e spalle aperte dopo una giornata alla scrivania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Costas retas e ombros abertos depois de um dia à mesa de trabalho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ровная спина и развернутые плечи после дня за столом."
          }
        }
      }
    },
    "life.pull_bar": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das eigene Körpergewicht halten und hochziehen – das ehrlichste Maß für Kraft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Holding and pulling your own bodyweight — the most honest measure of strength."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostener y traccionar el peso de tu propio cuerpo — la medida más honesta de la fuerza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenir et tirer le poids de ton corps — la mesure la plus honnête de la force."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Reggere il peso del tuo corpo e tirarti su – la misura più onesta della forza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segurar e puxar o peso do próprio corpo — a medida mais honesta da força."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удержать и подтянуть собственный вес — самая честная мера силы."
          }
        }
      }
    },
    "life.push_h": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine schwere Tür aufdrücken, vom Boden aufstehen, einen Sturz abfangen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pushing a heavy door, getting up from the ground, catching yourself when you fall."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empujar una puerta pesada, levantarte del suelo, amortiguar una caída."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pousser une porte lourde, se relever du sol, amortir une chute."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spingere una porta pesante, rialzarsi da terra, attutire una caduta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Empurrar uma porta pesada, levantar do chão, amortecer uma queda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Толкнуть тяжелую дверь, подняться с земли, смягчить падение."
          }
        }
      }
    },
    "life.push_v": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Koffer aufs oberste Regal heben, bis ins höchste Schrankfach greifen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lifting a suitcase onto the top shelf, reaching the highest cupboard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Subir la maleta al estante más alto, alcanzar el armario de arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hisser une valise en haut de l’armoire, atteindre le haut du placard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sollevare la valigia fin sopra l’armadio, raggiungere il ripiano più alto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Colocar a mala na prateleira de cima, alcançar o armário mais alto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закинуть чемодан на антресоль, дотянуться до верхней полки шкафа."
          }
        }
      }
    },
    "life.squat": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vom Boden oder vom Stuhl aufstehen, die Treppe hochlaufen – Kraft, die du jeden Tag brauchst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Getting up from the floor or a chair, taking stairs at a run — strength you use every day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Levantarte del suelo o de la silla, subir las escaleras corriendo — fuerza que usas cada día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se lever du sol ou d’une chaise, monter l’escalier en courant — une force que tu utilises tous les jours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alzarsi da terra o dalla sedia, fare le scale di corsa – la forza che usi ogni giorno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Levantar do chão ou da cadeira, subir a escada correndo — força que você usa todo dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встать с пола, со стула, взбежать по лестнице — сила, которой пользуешься каждый день."
          }
        }
      }
    },
