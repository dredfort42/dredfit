    "technique.stepDown.confirmBody": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bewegung geht eine Variante nach unten. Zurück nach oben führt eine Probe – der Plan bietet sie an, sobald die Dosis wieder am oberen Ende ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This movement drops to the variation below. The way back up is a probe, which the plan offers once the dose is at the ceiling again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El movimiento baja a la variación anterior. Para volver a subir está la prueba: el plan la ofrece cuando la dosis llega otra vez al tope."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mouvement descend d’une variante. Pour remonter, il y a l’essai : le programme le propose quand la dose atteint de nouveau le plafond."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il movimento scende alla variante precedente. Per risalire c’è la prova: il piano la propone quando la dose torna al massimo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O movimento desce para a variação anterior. Para voltar a subir existe o teste: o plano o oferece quando a dose chega de novo ao topo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Движение опустится на вариацию ниже. Обратно наверх ведет проба — план предложит ее, когда доза снова дойдет до потолка."
          }
        }
      }
    },
    "plan.probeNote": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danach eine Probe: ein Satz %1$@ · %2$@"
          }
        },
        "en": {
