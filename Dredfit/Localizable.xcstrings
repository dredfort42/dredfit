      }
    },
    "cooldown.chestWall.step1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterarm an der Wand, Ellenbogen auf Schulterhöhe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forearm on the wall, elbow at shoulder height."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antebrazo en la pared, codo a la altura del hombro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant-bras contre le mur, coude à hauteur d’épaule."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avambraccio al muro, gomito all’altezza della spalla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Antebraço na parede, cotovelo na altura do ombro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предплечье на стене, локоть на уровне плеча."
          }
        }
      }
    },
    "cooldown.chestWall.step2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dreh die Brust von der Wand weg, bis es vorn in der Schulter zieht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn the chest away from the wall until the front of the shoulder stretches."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gira el pecho alejándolo de la pared hasta sentir el estiramiento delante del hombro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tourne le buste à l’opposé du mur jusqu’à sentir l’étirement à l’avant de l’épaule."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruota il petto allontanandolo dal muro fino a sentire tirare davanti alla spalla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gire o peito para longe da parede até alongar a frente do ombro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разверни грудь от стены — до растяжения передней части плеча."
          }
        }
      }
    },
    "cooldown.chestWall.step3": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schulter tief, weg vom Ohr – dreh dich bis zur Dehnung, nicht bis zum Schmerz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the shoulder down, away from the ear — turn to a stretch, not into pain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hombro abajo, lejos de la oreja: gira hasta estirar, no hasta que duela."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Épaule basse, loin de l’oreille — tourne jusqu’à l’étirement, pas jusqu’à la douleur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spalla bassa, lontana dall’orecchio – ruota fino a sentire tirare, non fino al dolore."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ombro baixo, longe da orelha: gire até alongar, não até doer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плечо вниз, подальше от уха — разворачивайся до натяжения, не до боли."
          }
        }
      }
    },
    "cooldown.forwardFold": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorbeuge"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forward fold"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flexión hacia adelante"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flexion avant"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Piegamento in avanti"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Flexão à frente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наклон вперед стоя"
          }
        }
      }
    },
    "cooldown.forwardFold.step1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füße hüftbreit; beug dich aus der Hüfte nach vorn, Knie locker."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feet hip-width; fold forward from the hips, knees soft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pies al ancho de cadera; inclínate desde la cadera con las rodillas ligeramente flexionadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pieds largeur du bassin ; penche-toi en avant depuis les hanches, genoux souples."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Piedi alla larghezza dei fianchi; piegati in avanti a partire dalle anche, ginocchia morbide."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pés na largura do quadril; dobre o tronco a partir do quadril, joelhos levemente flexionados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стопы на ширине таза; наклонись вперед от таза, колени чуть согнуты."
          }
        }
      }
    },
    "cooldown.forwardFold.step2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass Kopf und Arme schwer hängen – streck dich nicht zum Boden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let the head and arms hang heavy — no reaching for the floor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja colgar la cabeza y los brazos: no fuerces hasta el suelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisse pendre la tête et les bras — ne cherche pas à toucher le sol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia che testa e braccia pendano pesanti – non cercare di toccare terra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe a cabeça e os braços pendurados: não force até o chão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голова и руки свободно висят — не тянись к полу."
          }
        }
      }
    },
    "cooldown.forwardFold.step3": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Roll dich langsam wieder auf, Wirbel für Wirbel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To come up, unroll the spine slowly, one vertebra at a time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para subir, desenrolla la espalda despacio, vértebra a vértebra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour remonter, déroule lentement la colonne, vertèbre par vertèbre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per risalire, srotola lentamente la schiena, una vertebra alla volta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para subir, desenrole as costas devagar, vértebra por vértebra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поднимайся медленно, раскручивая спину позвонок за позвонком."
          }
        }
      }
    },
    "cooldown.hipFlexors": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hüftbeuger dehnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hip flexor stretch"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flexores de cadera"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fléchisseurs de hanche"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Flessori dell’anca"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Flexores do quadril"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сгибатели бедра"
          }
        }
      }
    },
    "cooldown.hipFlexors.step1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh auf ein Knie, der andere Fuß steht vorn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kneel on one knee, the other foot planted in front."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apoya una rodilla en el suelo, con el otro pie plantado delante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose un genou au sol, l’autre pied à plat devant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti un ginocchio a terra, l’altro piede ben piantato davanti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apoie um joelho no chão, com o outro pé firme à frente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опустись на одно колено, другая стопа стоит впереди."
          }
        }
      }
    },
    "cooldown.hipFlexors.step2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richte das Becken auf und schieb es leicht nach vorn, bis es vorn in der Hüfte zieht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuck the pelvis and shift it slightly forward until the front of the hip stretches."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bascula la pelvis y llévala un poco hacia adelante hasta sentir el estiramiento delante de la cadera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bascule le bassin et avance-le légèrement jusqu’à sentir l’étirement à l’avant de la hanche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bascula il bacino e spostalo leggermente in avanti, fino a sentire tirare davanti all’anca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encaixe a pelve e leve-a um pouco à frente até sentir alongar a frente do quadril."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подкрути таз и подай его чуть вперед — до растяжения по передней поверхности бедра."
          }
        }
      }
    },
    "cooldown.hipFlexors.step3": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte die Position und atme – nicht wippen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold steady and breathe — no bouncing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén la posición y respira: sin rebotes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiens la position et respire — sans à-coups."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni la posizione e respira – senza molleggiare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha a posição e respire: sem balançar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держи положение и дыши — без пружинящих движений."
          }
        }
      }
    },
    "cooldown.latStretch": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Latissimus mit Stütze"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lat stretch with support"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dorsales con apoyo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dorsaux avec support"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dorsali con appoggio"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dorsais com apoio"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Широчайшие с опорой"
          }
        }
      }
    },
    "cooldown.latStretch.step1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte dich mit beiden Händen an einer Stütze auf Hüfthöhe fest, Füße unter der Hüfte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold a support at hip height with both hands, feet under the hips."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sujeta un apoyo a la altura de la cadera con ambas manos, pies bajo la cadera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attrape à deux mains un support à hauteur des hanches, pieds sous les hanches."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Afferra con entrambe le mani un appoggio all’altezza dei fianchi, piedi sotto le anche."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure um apoio na altura do quadril com as duas mãos, pés sob o quadril."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возьмись обеими руками за опору на уровне таза, стопы под тазом."
          }
        }
      }
    },
    "cooldown.latStretch.step2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schieb die Hüfte mit gestreckten Armen nach hinten, bis es seitlich im Rücken zieht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit the hips back on straight arms until the sides of the back stretch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva la cadera atrás con los brazos rectos hasta sentir el estiramiento a los lados de la espalda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pousse les hanches vers l’arrière, bras tendus, jusqu’à sentir l’étirement sur les côtés du dos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Porta il bacino indietro con le braccia tese, fino a sentire tirare ai lati della schiena."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leve o quadril para trás com os braços retos até alongar as laterais das costas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отведи таз назад на прямых руках — до растяжения по бокам спины."
          }
        }
      }
    },
    "cooldown.latStretch.step3": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopf zwischen den Armen; atme ruhig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the head between the arms and breathe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cabeza entre los brazos; respira con calma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde la tête entre les bras et respire tranquillement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni la testa tra le braccia e respira."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cabeça entre os braços; respire com calma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голова между рук; дыши спокойно."
          }
        }
      }
    },
    "cooldown.lyingTwist": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drehung im Liegen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lying twist"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Torsión en el suelo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Torsion allongée"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Torsione a terra"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Torção deitada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скручивание лежа"
          }
        }
      }
    },
    "cooldown.lyingTwist.step1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Rücken, Knie angewinkelt; lass beide Knie zu einer Seite sinken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On your back, knees bent; drop both knees to one side."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Boca arriba, rodillas dobladas; déjalas caer hacia un lado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur le dos, genoux fléchis ; laisse-les tomber d’un côté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A pancia in su, ginocchia piegate; lasciale cadere entrambe da un lato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De costas, joelhos dobrados; deixe-os cair para um lado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лежа на спине, согни колени и опусти их в сторону."
          }
        }
      }
    },
    "cooldown.lyingTwist.step2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schultern bleiben am Boden, der Kopf dreht sich zur anderen Seite."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shoulders stay on the floor, head turns the other way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los hombros siguen en el suelo; la cabeza gira hacia el lado contrario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les épaules restent au sol, la tête tourne de l’autre côté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le spalle restano a terra, la testa gira dall’altra parte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ombros ficam no chão; a cabeça vira para o lado oposto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плечи на полу, голова повернута в другую сторону."
          }
        }
      }
    },
    "cooldown.lyingTwist.step3": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass das Gewicht von allein sinken – drück die Knie nicht nach unten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let the weight sink on its own — don't push the knees down."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja que las rodillas bajen por su propio peso: no las empujes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisse le poids descendre tout seul — n’appuie pas sur les genoux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia che il peso scenda da solo – non spingere le ginocchia verso il basso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe o peso afundar sozinho: não empurre os joelhos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дай коленям опускаться под своим весом — не дави на них."
          }
        }
      }
    },
