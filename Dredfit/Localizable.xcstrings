    },
    "cooldown.latStretch.step1" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte dich mit beiden Händen an einer Stütze auf Hüfthöhe fest, Füße unter der Hüfte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold a support at hip height with both hands, feet under the hips."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sujeta un apoyo a la altura de la cadera con ambas manos, pies bajo la cadera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attrape à deux mains un support à hauteur des hanches, pieds sous les hanches."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afferra con entrambe le mani un appoggio all’altezza dei fianchi, piedi sotto le anche."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segure um apoio na altura do quadril com as duas mãos, pés sob o quadril."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возьмись обеими руками за опору на уровне таза, стопы под тазом."
          }
        }
      }
    },
    "cooldown.latStretch.step2" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schieb die Hüfte mit gestreckten Armen nach hinten, bis es seitlich im Rücken zieht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sit the hips back on straight arms until the sides of the back stretch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lleva la cadera atrás con los brazos rectos hasta sentir el estiramiento a los lados de la espalda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pousse les hanches vers l’arrière, bras tendus, jusqu’à sentir l’étirement sur les côtés du dos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porta il bacino indietro con le braccia tese, fino a sentire tirare ai lati della schiena."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leve o quadril para trás com os braços retos até alongar as laterais das costas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отведи таз назад на прямых руках — до растяжения по бокам спины."
          }
        }
      }
    },
    "cooldown.latStretch.step3" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopf zwischen den Armen; atme ruhig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the head between the arms and breathe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cabeza entre los brazos; respira con calma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde la tête entre les bras et respire tranquillement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni la testa tra le braccia e respira."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cabeça entre os braços; respire com calma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Голова между рук; дыши спокойно."
          }
        }
      }
    },
    "cooldown.lyingTwist" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
