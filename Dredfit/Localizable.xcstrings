    "How long every set of this exercise runs. Stop ends one early and records what you held.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie lange jeder Satz dieser Übung läuft. Stoppen beendet einen früher und erfasst, was du gehalten hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto dura cada serie de este ejercicio. Parar termina una antes y registra lo que aguantaste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La durée de chaque série de cet exercice. Arrêter en termine une plus tôt et enregistre ce que tu as tenu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto dura ogni serie di questo esercizio. Stop ne chiude una prima e registra quanto hai tenuto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto dura cada série deste exercício. Parar encerra uma antes e registra o que você sustentou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько идет каждый подход этого упражнения. Стоп заканчивает подход раньше и записывает удержанное."
          }
        }
      }
    },
