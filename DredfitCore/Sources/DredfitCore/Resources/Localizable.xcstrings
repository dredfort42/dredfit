        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cutting the range — rise all the way up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorrido corto: sube del todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Amplitude incomplète : monte jusqu’en haut."
