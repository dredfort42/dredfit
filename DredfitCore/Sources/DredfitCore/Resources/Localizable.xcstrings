          "stringUnit": {
            "state": "translated",
            "value": "Hips high, the body in one plane."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cadera alta y el cuerpo en un mismo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bassin haut, le corps dans un seul plan."
          }
        },
        "it": {
