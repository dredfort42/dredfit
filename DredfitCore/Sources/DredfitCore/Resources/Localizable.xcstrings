    "Lie on your back, press the lower back into the floor, arms extended overhead.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg dich auf den Rücken, drück den unteren Rücken in den Boden und streck die Arme über den Kopf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lie on your back, press the lower back into the floor, arms extended overhead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acuéstate boca arriba, pega la zona lumbar al suelo y estira los brazos por encima de la cabeza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allonge-toi sur le dos, plaque le bas du dos au sol et tends les bras derrière la tête."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdraiati sulla schiena, premi la zona lombare a terra e distendi le braccia sopra la testa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deite-se de costas, cole a lombar no chão e estenda os braços acima da cabeça."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лежа на спине, прижми поясницу к полу, руки вытяни за голову."
          }
        }
      }
    },
    "Lift the shoulder blades and straight legs 15–20 cm off the floor.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heb die Schulterblätter und die gestreckten Beine 15–20 cm vom Boden ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lift the shoulder blades and straight legs 15–20 cm off the floor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Despega del suelo las escápulas y las piernas estiradas 15–20 cm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soulève les omoplates et les jambes tendues à 15–20 cm du sol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solleva le scapole e le gambe tese di 15–20 cm da terra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tire as escápulas e as pernas esticadas 15–20 cm do chão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оторви лопатки и прямые ноги от пола на 15–20 см."
          }
        }
      }
    },
    "Hold the hollow shape with the lower back pressed down the whole time.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte die Hollow-Position, der untere Rücken bleibt die ganze Zeit fest am Boden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the hollow shape with the lower back pressed down the whole time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén la posición hollow con la zona lumbar pegada al suelo todo el tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiens la position hollow, le bas du dos plaqué au sol en permanence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni la posizione hollow con la zona lombare sempre premuta a terra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure a posição hollow com a lombar colada no chão o tempo todo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держи «лодочку», поясница все время прижата."
          }
        }
      }
    },
    "Lower back lifting off the floor — raise the legs higher or bend the knees.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der untere Rücken löst sich vom Boden – heb die Beine höher oder beug die Knie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower back lifting off the floor — raise the legs higher or bend the knees."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La zona lumbar se despega del suelo: sube más las piernas o dobla las rodillas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bas du dos se décolle : monte les jambes plus haut ou plie les genoux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La zona lombare si stacca da terra – alza di più le gambe o piega le ginocchia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A lombar sai do chão: suba mais as pernas ou dobre os joelhos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поясница отрывается от пола — подними ноги выше или согни колени."
          }
        }
      }
    },
    "Holding your breath — keep breathing shallow and steady.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hältst die Luft an – atme flach und gleichmäßig weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Holding your breath — keep breathing shallow and steady."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguantar la respiración: respira suave y de forma regular."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu retiens ton souffle : continue de respirer doucement et régulièrement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stai trattenendo il respiro – continua a respirare in modo leggero e regolare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prender a respiração: respire leve e de forma regular."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задержка дыхания — дыши ровно и неглубоко."
          }
        }
      }
    },
    "Long-lever plank": {
