            "state": "translated",
            "value": "Поднимись на носок максимально высоко, секунда паузы."
          }
        }
      }
    },
    "Lower slowly, heel to the floor (or below step level).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Senk dich langsam ab, die Ferse bis zum Boden (oder unter die Stufenkante)."
          }
