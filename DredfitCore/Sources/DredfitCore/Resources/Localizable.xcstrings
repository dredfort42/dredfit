    "Keep the body rigid and lower until the chest nearly touches the floor.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte den Körper unter Spannung und senk dich ab, bis die Brust den Boden fast berührt."
