    },
    "Leg drifting forward — keep it in line with the torso.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Bein wandert nach vorn – halte es in einer Linie mit dem Rumpf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg drifting forward — keep it in line with the torso."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pierna se va hacia adelante: mantenla alineada con el torso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La jambe part vers l’avant : garde-la dans l’alignement du tronc."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La gamba si sposta in avanti – tienila in linea con il busto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A perna vai para a frente: mantenha-a alinhada com o tronco."
