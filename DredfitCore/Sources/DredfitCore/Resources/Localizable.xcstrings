          "stringUnit": {
            "state": "translated",
            "value": "Helping with the other leg — it stays off the floor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayudarte con la otra pierna: se queda en el aire."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’aider de l’autre jambe : elle reste en l’air."
          }
