            "state": "translated",
            "value": "Torso tipping forward — keep the chest up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El torso se va hacia adelante: mantén el pecho arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le buste bascule vers l’avant : garde la poitrine haute."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il busto si inclina in avanti – tieni il petto alto."
          }
