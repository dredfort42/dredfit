    "Grab the bar slightly wider than shoulder width, palms facing away.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Greif die Stange etwas breiter als schulterbreit, Handflächen von dir weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grab the bar slightly wider than shoulder width, palms facing away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agarra la barra algo más abierto que la anchura de los hombros, con las palmas hacia fuera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attrape la barre un peu plus large que les épaules, paumes vers l’avant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Afferra la sbarra con una presa appena più larga delle spalle, palmi rivolti in avanti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure a barra um pouco mais aberto que a largura dos ombros, com as palmas para fora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возьмись за перекладину хватом чуть шире плеч, ладони от себя."
          }
        }
      }
    },
    "Hang on straight arms and pull the shoulders slightly down — an active hang, shoulders away from the ears.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Häng dich mit gestreckten Armen an die Stange und zieh die Schultern leicht nach unten – aktiv hängen, Schultern weg von den Ohren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hang on straight arms and pull the shoulders slightly down — an active hang, shoulders away from the ears."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuélgate con los brazos estirados y baja un poco los hombros: es una suspensión activa, sin meter la cabeza entre ellos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspends-toi bras tendus et tire légèrement les épaules vers le bas — suspension active, épaules loin des oreilles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appenditi a braccia distese e tira leggermente le spalle verso il basso – sospensione attiva, spalle lontane dalle orecchie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendure-se com os braços esticados e puxe os ombros levemente para baixo: a suspensão é ativa, sem encolher a cabeça."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повисни на прямых руках и слегка потяни плечи вниз — вис активный, голова не втянута."
          }
        }
      }
    },
    "Keep the body tight, legs together; breathe steadily for the whole hang.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte den Körper unter Spannung, die Beine zusammen; atme gleichmäßig, solange du hängst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the body tight, legs together; breathe steadily for the whole hang."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén el cuerpo firme y las piernas juntas; respira de forma regular durante toda la suspensión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde le corps gainé, jambes serrées ; respire régulièrement pendant toute la suspension."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni il corpo compatto, gambe unite; respira in modo regolare per tutta la sospensione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o corpo firme e as pernas juntas; respire de forma regular enquanto estiver pendurado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держи корпус собранным, ноги вместе; дыши ровно все время виса."
          }
        }
      }
    },
    "Shoulders at the ears — pull the shoulder blades down; the hang must be active.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schultern an den Ohren – zieh die Schulterblätter nach unten; das Hängen muss aktiv sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shoulders at the ears — pull the shoulder blades down; the hang must be active."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hombros pegados a las orejas: lleva las escápulas hacia abajo; la suspensión tiene que ser activa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les épaules montent vers les oreilles : tire les omoplates vers le bas ; la suspension doit rester active."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spalle alle orecchie – porta le scapole verso il basso; la sospensione deve essere attiva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ombros colados nas orelhas: puxe as escápulas para baixo; a suspensão precisa ser ativa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плечи у ушей — потяни лопатки вниз, вис должен быть активным."
          }
        }
      }
    },
    "Swinging — keep the body braced, no pendulum.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schwingen – halte den Körper unter Spannung, kein Pendeln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swinging — keep the body braced, no pendulum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Balanceo: mantén el cuerpo firme, sin hacer de péndulo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balancement : garde le corps gainé, pas d’effet pendule."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oscillazioni – tieni il corpo in tensione, niente pendolo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Balanço: mantenha o corpo firme, sem virar pêndulo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раскачивание — держи корпус жестким, без маятника."
          }
        }
      }
    },
    "Step on a support or jump so the chin ends up above the bar.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell dich auf eine Erhöhung oder spring hoch, sodass das Kinn über der Stange landet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step on a support or jump so the chin ends up above the bar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Súbete a un apoyo o salta para dejar la barbilla por encima de la barra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Monte sur un support ou saute pour amener le menton au-dessus de la barre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sali su un rialzo o salta in modo che il mento arrivi sopra la sbarra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suba num apoio ou salte para deixar o queixo acima da barra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встань на опору или подпрыгни так, чтобы подбородок оказался над перекладиной."
          }
        }
      }
    },
    "Lower yourself slowly to straight arms over 3–5 seconds, controlling every inch.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass dich in 3–5 Sekunden langsam ab, bis die Arme gestreckt sind, und kontrolliere jeden Zentimeter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower yourself slowly to straight arms over 3–5 seconds, controlling every inch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja despacio hasta estirar los brazos, durante 3–5 segundos, controlando cada centímetro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Descends lentement en 3–5 secondes jusqu’aux bras tendus, en contrôlant chaque centimètre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scendi lentamente fino a braccia distese in 3–5 secondi, controllando ogni centimetro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desça devagar até esticar os braços, ao longo de 3–5 segundos, controlando cada centímetro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Медленно опускайся на прямые руки 3–5 секунд, контролируя каждый сантиметр."
          }
        }
      }
    },
    "Get back on the support and repeat — no pulling up needed.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steig wieder auf die Erhöhung und wiederhole – hochziehen musst du dich nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get back on the support and repeat — no pulling up needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve al apoyo y repite: no hace falta subir a pulso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remonte sur le support et recommence — inutile de te hisser à la force des bras."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna sul rialzo e ripeti – non serve tirarsi su."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Volte para o apoio e repita: não precisa subir na força."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернись на опору и повтори — подниматься силой не нужно."
          }
        }
      }
    },
    "Dropping instead of lowering — the negative takes at least 3 seconds.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fallenlassen statt Ablassen – die Negative dauert mindestens 3 Sekunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dropping instead of lowering — the negative takes at least 3 seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejarte caer en vez de bajar: la negativa dura al menos 3 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Te laisser tomber au lieu de descendre : la négative dure au moins 3 secondes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lasciarti cadere invece di scendere – la fase negativa dura almeno 3 secondi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cair em vez de descer: a negativa dura pelo menos 3 segundos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Падение вместо опускания — негатив длится не меньше 3 секунд."
          }
        }
      }
    },
    "Relaxed shoulders at the bottom — keep the shoulder blades engaged to the end.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lockere Schultern unten – halte die Schulterblätter bis zum Schluss aktiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Relaxed shoulders at the bottom — keep the shoulder blades engaged to the end."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hombros relajados abajo: mantén las escápulas activas hasta el final."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Épaules relâchées en bas : garde les omoplates actives jusqu’au bout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spalle rilassate in basso – tieni le scapole attive fino alla fine."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ombros relaxados embaixo: mantenha as escápulas ativas até o fim."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расслабленные плечи внизу — держи лопатки включенными до конца."
          }
        }
      }
    },
    "Hang on straight arms, grip slightly wider than shoulders, palms facing away.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Häng dich mit gestreckten Armen an die Stange, Griff etwas breiter als schulterbreit, Handflächen von dir weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hang on straight arms, grip slightly wider than shoulders, palms facing away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuélgate con los brazos estirados, con el agarre algo más abierto que los hombros y las palmas hacia fuera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspends-toi bras tendus, prise un peu plus large que les épaules, paumes vers l’avant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appenditi a braccia distese, presa appena più larga delle spalle, palmi rivolti in avanti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendure-se com os braços esticados, a pegada um pouco mais aberta que os ombros e as palmas para fora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повисни на прямых руках, хват чуть шире плеч, ладони от себя."
          }
        }
      }
    },
    "Start by squeezing the shoulder blades and pull up to a right angle at the elbows.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führ zuerst die Schulterblätter zusammen und zieh dich hoch, bis die Ellenbogen einen rechten Winkel bilden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start by squeezing the shoulder blades and pull up to a right angle at the elbows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza juntando las escápulas y sube hasta formar un ángulo recto con los codos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commence par resserrer les omoplates et hisse-toi jusqu’à former un angle droit aux coudes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvicina prima le scapole e tirati su finché i gomiti non formano un angolo retto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece juntando as escápulas e puxe até formar um ângulo reto nos cotovelos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начни со сведения лопаток и подтянись до прямого угла в локтях."
          }
        }
      }
    },
    "Lower slowly to straight arms — that's one rep.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass dich langsam ab, bis die Arme gestreckt sind – das ist eine Wiederholung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower slowly to straight arms — that's one rep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja despacio hasta estirar los brazos: eso es una repetición."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redescends lentement jusqu’aux bras tendus — c’est une répétition."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scendi lentamente fino a braccia distese – questa è una ripetizione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desça devagar até esticar os braços: isso é uma repetição."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Медленно опустись на прямые руки — это один повтор."
          }
        }
      }
    },
    "Jerking and kicking with the legs — only the back and arms work.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruckartiges Ziehen und Schwung aus den Beinen – nur Rücken und Arme arbeiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jerking and kicking with the legs — only the back and arms work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirones y patadas con las piernas: solo trabajan la espalda y los brazos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À-coups et élan des jambes : seuls le dos et les bras travaillent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Strattoni e slanci con le gambe – lavorano solo schiena e braccia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrancos e chutes com as pernas: só as costas e os braços trabalham."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рывки и помощь ногами — работают только спина и руки."
          }
        }
      }
    },
    "Cutting the bottom range — every rep starts from fully straight arms.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verkürzter Weg unten – jede Wiederholung beginnt mit komplett gestreckten Armen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cutting the bottom range — every rep starts from fully straight arms."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recortar el recorrido abajo: cada repetición empieza con los brazos del todo estirados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Amplitude écourtée en bas : chaque répétition part des bras complètement tendus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ampiezza accorciata in basso – ogni ripetizione parte da braccia completamente distese."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cortar a amplitude embaixo: cada repetição começa com os braços totalmente esticados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срезанная амплитуда внизу — каждый повтор с полностью прямых рук."
          }
        }
      }
    },
    "Pull up, starting by squeezing the shoulder blades, until the chin rises above the bar.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führ zuerst die Schulterblätter zusammen und zieh dich hoch, bis das Kinn über der Stange ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull up, starting by squeezing the shoulder blades, until the chin rises above the bar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube empezando por juntar las escápulas, hasta que la barbilla pase por encima de la barra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hisse-toi en commençant par resserrer les omoplates, jusqu’à ce que le menton passe au-dessus de la barre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvicina prima le scapole e tirati su finché il mento non supera la sbarra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Puxe começando por juntar as escápulas, até o queixo passar acima da barra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтянись, начиная со сведения лопаток, пока подбородок не поднимется над перекладиной."
          }
        }
      }
    },
    "Lower under control to fully straight arms, no swinging.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass dich kontrolliert ab, bis die Arme komplett gestreckt sind, ohne zu schwingen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower under control to fully straight arms, no swinging."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja con control hasta estirar del todo los brazos, sin balanceo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redescends de manière contrôlée jusqu’aux bras complètement tendus, sans te balancer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scendi in modo controllato fino a braccia completamente distese, senza oscillare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desça com controle até esticar os braços por completo, sem balanço."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опустись под контролем до полностью прямых рук, без раскачки."
          }
        }
      }
    },
    "Swinging and jerking the body — kipping doesn't count.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schwingen und Rucken mit dem Körper – Klimmzüge mit Schwung zählen nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swinging and jerking the body — kipping doesn't count."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Balancear el cuerpo y hacer tirones: el kipping no cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balancement et à-coups du corps : les tractions avec élan ne comptent pas."
          }
        },
        "it": {
          "stringUnit": {
