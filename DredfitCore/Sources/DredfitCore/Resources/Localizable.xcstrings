    "From standing, step back and lower the rear knee almost to the floor.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach aus dem Stand einen Schritt nach hinten und senke das hintere Knie fast bis zum Boden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From standing, step back and lower the rear knee almost to the floor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De pie, da un paso atrás y baja la rodilla trasera casi hasta el suelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Debout, recule d’un pas et descends le genou arrière presque jusqu’au sol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da in piedi, porta un piede indietro e scendi con il ginocchio di dietro quasi a terra."
