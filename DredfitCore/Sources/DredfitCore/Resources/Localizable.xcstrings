      }
    },
    "Breathe steadily and hold for the planned time.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Atme gleichmäßig und halte die geplante Zeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Breathe steadily and hold for the planned time."
          }
        },
        "es": {
