            "state": "translated",
            "value": "Archer inverted row"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Remo invertido de arquero"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rowing inversé archer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rematore arciere"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remada invertida arqueiro"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тяга «лучник» под опорой"
          }
        }
      }
    },
    "Set up under the table with a wide grip, body straight.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg dich mit breitem Griff unter den Tisch, Körper gerade."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up under the table with a wide grip, body straight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Colócate bajo la mesa con un agarre ancho y el cuerpo recto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installe-toi sous la table en prise large, le corps droit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettiti sotto il tavolo con una presa larga, corpo dritto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Posicione-se embaixo da mesa com pegada aberta e o corpo reto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ляг под стол и возьмись за край широким хватом, тело прямое."
          }
        }
      }
    },
    "Pull the chest toward one hand; the other arm stays nearly straight.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh die Brust zu einer Hand; der andere Arm bleibt fast gestreckt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull the chest toward one hand; the other arm stays nearly straight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva el pecho hacia una mano; el otro brazo se queda casi estirado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tire la poitrine vers une main ; l’autre bras reste presque tendu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Porta il petto verso una mano; l’altro braccio resta quasi disteso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Puxe o peito em direção a uma das mãos; o outro braço fica quase estendido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тяни грудь к одной руке; вторая рука почти прямая."
          }
        }
      }
    },
    "Lower under control; whole set to one side, then switch.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Senk dich kontrolliert ab; den ganzen Satz auf einer Seite, dann wechseln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower under control; whole set to one side, then switch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja con control; toda la serie a un lado y después cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôle la descente ; fais toute la série d’un côté, puis change."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scendi in modo controllato; tutta la serie da un lato, poi cambia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desça com controle; a série inteira de um lado e depois troque."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опускайся под контролем; весь подход в одну сторону, затем смена."
          }
        }
      }
    },
    "Hips sagging — hold the plank line through the set.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Hüfte hängt durch – halte die Plank-Linie den ganzen Satz über."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hips sagging — hold the plank line through the set."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cadera se hunde: sostén la línea de plancha durante toda la serie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bassin s’affaisse : garde l’alignement de la planche pendant toute la série."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il bacino cede – mantieni la linea del plank per tutta la serie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O quadril afunda: sustente a linha da prancha durante toda a série."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Таз провисает — держи линию планки весь подход."
          }
        }
      }
    },
    "Both arms pulling equally — the working arm does the job.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide Arme ziehen gleich stark – die Arbeit macht der aktive Arm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both arms pulling equally — the working arm does the job."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dos brazos tiran por igual: el trabajo lo hace el brazo activo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux bras tirent autant l’un que l’autre : c’est le bras actif qui fait le travail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrambe le braccia tirano allo stesso modo – il lavoro lo fa il braccio attivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dois braços puxam igual: quem faz o trabalho é o braço ativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обе руки тянут одинаково — работать должна одна."
          }
        }
      }
    },
    "Wall push-up": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liegestütze an der Wand"
          }
        },
        "en": {
