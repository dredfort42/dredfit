          "stringUnit": {
            "state": "translated",
            "value": "Lower slowly, heel to the floor (or below step level)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja despacio, con el talón hasta el suelo (o por debajo del escalón)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redescends lentement, le talon jusqu’au sol (ou plus bas que la marche)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scendi lentamente, con il tallone fino a terra (o sotto il livello dello scalino)."
