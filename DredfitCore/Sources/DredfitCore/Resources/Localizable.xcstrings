    "Forearms on the floor, elbows under the shoulders, feet hip-width.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterarme auf dem Boden, Ellenbogen unter den Schultern, Füße hüftbreit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forearms on the floor, elbows under the shoulders, feet hip-width."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antebrazos en el suelo, codos bajo los hombros, pies al ancho de la cadera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant-bras au sol, coudes sous les épaules, pieds à la largeur du bassin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avambracci a terra, gomiti sotto le spalle, piedi alla larghezza dei fianchi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Antebraços no chão, cotovelos sob os ombros, pés na largura do quadril."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предплечья на полу, локти под плечами, стопы на ширине таза."
          }
        }
      }
    },
    "One straight line from head to heels; glutes and abs braced.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine gerade Linie vom Kopf bis zu den Fersen; Po und Bauch angespannt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One straight line from head to heels; glutes and abs braced."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una línea recta de la cabeza a los talones; glúteos y abdomen firmes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une ligne droite de la tête aux talons ; fessiers et abdos contractés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’unica linea retta dalla testa ai talloni; glutei e addome contratti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma linha reta da cabeça aos calcanhares; glúteos e abdômen firmes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прямая линия от макушки до пят; ягодицы и пресс напряжены."
          }
        }
      }
    },
    "Breathe steadily; shaking is fine, a sagging line is not.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Atme gleichmäßig; Zittern ist okay, Durchhängen nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Breathe steadily; shaking is fine, a sagging line is not."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Respira de forma regular; temblar es normal, hundirse no."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Respire régulièrement ; trembler, c’est normal, s’affaisser, non."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Respira in modo regolare; tremare è normale, cedere no."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Respire de forma regular; tremer é normal, afundar não."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дыши ровно; дрожь мышц — норма, провал линии — стоп."
          }
        }
      }
    },
    "Hips hiked up — easier, but pointless.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Hüfte wandert nach oben – so ist es leichter, bringt aber nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hips hiked up — easier, but pointless."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadera levantada: es más fácil, pero no sirve de nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bassin monte trop haut : c’est plus facile, mais ça ne sert à rien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il bacino se ne va verso l’alto – così è più facile, ma non serve a niente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quadril empinado: fica mais fácil, mas não adianta nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Таз задран вверх — так легче, но толку нет."
          }
        }
      }
    },
    "Lower back sagging — that strains the spine; better to stop early.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der untere Rücken hängt durch – das belastet die Wirbelsäule; hör lieber früher auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower back sagging — that strains the spine; better to stop early."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La zona lumbar se hunde: eso sobrecarga la columna; mejor parar antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bas du dos s’affaisse : ça surcharge la colonne ; mieux vaut arrêter plus tôt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La zona lombare cede – questo sovraccarica la colonna; meglio fermarsi prima."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A lombar afunda: isso sobrecarrega a coluna; melhor parar antes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поясница провисает — это риск для спины, лучше закончить раньше."
          }
        }
      }
    },
    "Hollow hold": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hollow Hold"
          }
        },
        "en": {
