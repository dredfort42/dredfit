        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raise the top leg 20–30 cm and hold it straight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube la pierna de arriba 20–30 cm y mantenla estirada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lève la jambe du dessus de 20–30 cm et garde-la tendue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solleva la gamba superiore di 20–30 cm e mantienila tesa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suba a perna de cima 20–30 cm e mantenha-a esticada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подними верхнюю ногу на 20–30 см и держи ее прямой."
          }
        }
      }
    },
    "Hips high, the body in one plane.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Hüfte hoch, der Körper in einer Ebene."
          }
        },
