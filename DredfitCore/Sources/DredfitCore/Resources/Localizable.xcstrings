          "stringUnit": {
            "state": "translated",
            "value": "Drive up through the front heel, torso upright."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube empujando con el talón de delante, el torso erguido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remonte en poussant dans le talon avant, le buste bien droit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risali spingendo sul tallone davanti, busto eretto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suba empurrando com o calcanhar da frente, o tronco ereto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вверх через пятку передней ноги, корпус прямой."
          }
        }
      }
    },
    "Front knee traveling far past the toes — take a longer stance.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das vordere Knie wandert weit über die Zehen – mach den Schritt länger."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Front knee traveling far past the toes — take a longer stance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La rodilla de delante se va muy por delante de la punta: alarga el paso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le genou avant dépasse largement la pointe du pied : allonge le pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ginocchio davanti va molto oltre la punta del piede – allunga la falcata."
          }
        },
        "pt-BR": {
