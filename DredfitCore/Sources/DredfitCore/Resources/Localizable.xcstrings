    },
    "Helping with the other leg — it stays off the floor.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das andere Bein hilft mit – es bleibt komplett in der Luft."
