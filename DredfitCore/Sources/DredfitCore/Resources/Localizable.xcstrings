    "Body folding forward — shoulders, hips and legs in one plane.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Körper klappt nach vorn – Schultern, Hüfte und Beine in einer Ebene."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Body folding forward — shoulders, hips and legs in one plane."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cuerpo se pliega hacia adelante: hombros, cadera y piernas en un mismo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le corps se plie vers l’avant : épaules, bassin et jambes dans le même plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il corpo si piega in avanti – spalle, bacino e gambe sullo stesso piano."
          }
        },
        "pt-BR": {
          "stringUnit": {
