    },
    "Torso tipping forward — keep the chest up.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Oberkörper kippt nach vorn – die Brust bleibt oben."
