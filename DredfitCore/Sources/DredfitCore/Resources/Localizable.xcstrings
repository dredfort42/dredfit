    "Drive up through the front heel, torso upright.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drück dich über die vordere Ferse hoch, der Oberkörper bleibt aufrecht."
          }
        },
