    "From a push-up position, lift the hips high — the body forms an inverted V.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heb aus der Liegestützposition die Hüfte weit nach oben – der Körper bildet ein umgekehrtes V."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From a push-up position, lift the hips high — the body forms an inverted V."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde la posición de flexión, sube mucho la cadera: el cuerpo forma una V invertida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depuis la position de pompes, monte le bassin bien haut : le corps forme un V inversé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalla posizione delle flessioni, porta il bacino ben in alto – il corpo forma una V rovesciata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Da posição de flexão, suba bem o quadril: o corpo forma um V invertido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Из упора лежа подними таз вверх — тело углом, как перевернутая V."
          }
        }
      }
    },
    "Bend the elbows, lowering the top of the head toward the floor between the hands.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beug die Ellenbogen und senk den Scheitel zwischen den Händen Richtung Boden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bend the elbows, lowering the top of the head toward the floor between the hands."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobla los codos bajando la coronilla hacia el suelo, entre las manos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plie les coudes en descendant le sommet du crâne vers le sol, entre les mains."
          }
        },
        "it": {
