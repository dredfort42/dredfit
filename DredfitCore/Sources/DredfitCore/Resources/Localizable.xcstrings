            "value": "Отжимания от стены"
          }
        }
      }
    },
    "Stand a step away from a wall, palms on it slightly wider than shoulders, at chest height.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell dich einen Schritt vor die Wand und leg die Handflächen auf Brusthöhe an, etwas breiter als die Schultern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand a step away from a wall, palms on it slightly wider than shoulders, at chest height."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponte a un paso de la pared, con las palmas en ella algo más abiertas que los hombros, a la altura del pecho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Place-toi à un pas du mur, les paumes posées dessus à hauteur de poitrine, un peu plus écartées que les épaules."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettiti a un braccio di distanza dal muro, con i palmi appoggiati poco più larghi delle spalle, all’altezza del petto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fique a um passo da parede, com as palmas nela um pouco mais abertas que os ombros, na altura do peito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встань в шаге от стены, ладони на ней чуть шире плеч на уровне груди."
          }
        }
      }
    },
    "Bend the elbows, bringing the face toward the wall, body in one line.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beug die Ellenbogen und bring das Gesicht Richtung Wand, der Körper bleibt eine Linie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bend the elbows, bringing the face toward the wall, body in one line."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobla los codos acercando la cara a la pared, con el cuerpo en una línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plie les coudes en approchant le visage du mur, le corps bien aligné."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Piega i gomiti avvicinando il viso al muro, corpo in un’unica linea."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobre os cotovelos aproximando o rosto da parede, com o corpo em uma linha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Согни локти, приближая лицо к стене, тело — одна линия."
          }
        }
      }
    },
    "Push back to straight arms; the farther the feet, the harder.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drück dich zurück, bis die Arme gestreckt sind; je weiter weg die Füße, desto schwerer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Push back to straight arms; the farther the feet, the harder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empuja hasta estirar los brazos; cuanto más lejos los pies, más difícil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repousse-toi jusqu’à tendre les bras ; plus les pieds sont loin, plus c’est difficile."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spingiti indietro fino a braccia distese; più i piedi sono lontani, più è difficile."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Empurre até esticar os braços; quanto mais longe os pés, mais difícil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оттолкнись до прямых рук; чем дальше стопы, тем тяжелее."
          }
        }
      }
    },
    "Hips dropping back — the whole body moves as one line.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Hüfte weicht nach hinten aus – der ganze Körper bewegt sich als eine Linie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hips dropping back — the whole body moves as one line."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cadera se va hacia atrás: todo el cuerpo se mueve como una sola línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bassin recule : tout le corps bouge d’un seul bloc."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il bacino arretra – tutto il corpo si muove come un’unica linea."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O quadril vai para trás: o corpo inteiro se move como uma linha só."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Таз уходит назад — двигается все тело единой линией."
          }
        }
      }
    },
    "Elbows flared to 90° — keep them closer to the torso.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ellenbogen sind auf 90° abgespreizt – halte sie näher am Körper."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Elbows flared to 90° — keep them closer to the torso."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Codos abiertos a 90°: mantenlos más cerca del torso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les coudes s’ouvrent à 90° : garde-les plus près du buste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gomiti aperti a 90° – tienili più vicini al busto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cotovelos abertos a 90°: mantenha-os mais perto do tronco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локти разведены на 90° — держи их ближе к корпусу."
          }
        }
      }
    },
    "Pike push-up": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pike-Liegestütze"
          }
        },
        "en": {
