            "value": "Halte oben eine Sekunde, dann senk dich kontrolliert ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause a second at the top; lower under control."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un segundo de pausa arriba; baja con control."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reste une seconde en haut ; contrôle la descente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermati un secondo in alto; scendi in modo controllato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um segundo de pausa em cima; desça com controle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Секунда паузы вверху; опускание под контролем."
          }
        }
      }
    },
    "Reaching with the chin instead of the chest — lead with the chest.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Kinn schiebt sich vor statt der Brust – führ die Bewegung mit der Brust."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reaching with the chin instead of the chest — lead with the chest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llegar con la barbilla en lugar del pecho: guía el movimiento con el pecho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le menton avance au lieu de la poitrine : guide le mouvement avec la poitrine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrivare con il mento invece che con il petto – guida il movimento con il petto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chegar com o queixo em vez do peito: conduza o movimento com o peito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подбородок тянется вместо груди — веди движение грудью."
          }
        }
      }
    },
    "Rushing the reps — control both directions.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu schnelles Tempo – kontrolliere die Bewegung in beide Richtungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rushing the reps — control both directions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ir demasiado rápido: controla el movimiento en los dos sentidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aller trop vite : contrôle le mouvement dans les deux sens."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritmo troppo veloce – controlla il movimento in entrambe le direzioni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ir rápido demais: controle o movimento nos dois sentidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком быстрый темп — контролируй движение в обе стороны."
          }
        }
      }
    },
    "Archer inverted row": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Archer-Rudern am Tisch"
          }
