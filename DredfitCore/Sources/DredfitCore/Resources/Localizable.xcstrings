    "Stand with feet hip-width; hand on a wall for balance.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell dich hüftbreit hin; eine Hand an der Wand fürs Gleichgewicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand with feet hip-width; hand on a wall for balance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De pie con los pies al ancho de la cadera; una mano en la pared para equilibrarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Debout, pieds à la largeur du bassin ; une main sur le mur pour l’équilibre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettiti con i piedi alla larghezza dei fianchi; una mano al muro per l’equilibrio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em pé com os pés na largura do quadril; uma mão na parede para equilibrar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стоя, стопы на ширине таза; рука на стене для равновесия."
          }
        }
      }
    },
    "Rise as high as you can onto the balls of the feet, pause a second at the top.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drück dich so hoch wie möglich auf die Fußballen, halte oben eine Sekunde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rise as high as you can onto the balls of the feet, pause a second at the top."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube todo lo que puedas sobre las puntas de los pies y haz una pausa de un segundo arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Monte le plus haut possible sur la pointe des pieds, une seconde de pause en haut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sollevati sulle punte il più in alto possibile, un secondo di pausa in alto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suba o máximo que conseguir na ponta dos pés e faça uma pausa de um segundo em cima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поднимись на носки максимально высоко, секунда паузы вверху."
          }
        }
      }
    },
    "Lower slowly; for more range, stand with the toes on a step edge.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Senk dich langsam ab; für mehr Bewegungsumfang stell dich mit den Zehen auf eine Stufenkante."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower slowly; for more range, stand with the toes on a step edge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja despacio; para más recorrido, apoya las puntas en el borde de un escalón."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redescends lentement ; pour plus d’amplitude, pose la pointe des pieds sur le bord d’une marche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scendi lentamente; per maggiore ampiezza, appoggia le punte sul bordo di uno scalino."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desça devagar; para mais amplitude, apoie as pontas dos pés na borda de um degrau."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Медленно опустись; для амплитуды — носки на край ступеньки."
          }
        }
      }
    },
    "Fast bouncing — move slowly with a pause at the top.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnelles Wippen – arbeite langsam, halte oben kurz inne."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast bouncing — move slowly with a pause at the top."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebotes rápidos: muévete despacio y con pausa arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebonds rapides : travaille lentement, avec une pause en haut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Molleggi veloci – muoviti lentamente, con una pausa in alto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quicadas rápidas: faça devagar, com pausa em cima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстрые «отскоки» — работай медленно, с паузой вверху."
          }
