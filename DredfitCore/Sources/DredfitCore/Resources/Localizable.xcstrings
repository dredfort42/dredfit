{
  "sourceLanguage": "en",
  "strings": {
    "Squat": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kniebeuge"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Squat"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentadilla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Squat"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Squat"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agachamento"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Присед"
          }
        }
      }
    },
    "Feet shoulder-width apart, toes slightly out, weight over the whole foot.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füße schulterbreit, Zehen leicht nach außen, das Gewicht auf dem ganzen Fuß."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feet shoulder-width apart, toes slightly out, weight over the whole foot."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pies al ancho de los hombros, puntas ligeramente hacia fuera, el peso en todo el pie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pieds à la largeur des épaules, pointes de pieds légèrement vers l’extérieur, le poids sur tout le pied."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Piedi alla larghezza delle spalle, punte leggermente in fuori, il peso su tutto il piede."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pés na largura dos ombros, pontas levemente para fora, o peso em todo o pé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стопы на ширине плеч, носки слегка наружу, вес на всей стопе."
          }
        }
      }
    },
    "Sit back and down for ~2 seconds; knees track over the toes, back straight.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setz dich ~2 Sekunden nach hinten und unten; die Knie zeigen in Richtung der Zehen, der Rücken bleibt gerade."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit back and down for ~2 seconds; knees track over the toes, back straight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siéntate atrás y abajo durante ~2 segundos; las rodillas siguen la línea de los pies, la espalda recta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Descends comme pour t’asseoir en arrière pendant ~2 secondes ; les genoux restent dans l’axe des pieds, le dos droit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Siediti all’indietro e in basso per ~2 secondi; le ginocchia seguono la linea delle punte, la schiena resta dritta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sente para trás e para baixo por ~2 segundos; os joelhos seguem a linha dos pés, a coluna reta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Садись назад и вниз ~2 секунды; колени идут по линии носков, спина прямая."
          }
        }
      }
    },
    "Thighs parallel to the floor at the bottom; drive up on an exhale.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unten sind die Oberschenkel parallel zum Boden; drück dich mit dem Ausatmen wieder hoch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thighs parallel to the floor at the bottom; drive up on an exhale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abajo, los muslos quedan paralelos al suelo; sube soltando el aire."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En bas, les cuisses sont parallèles au sol ; remonte en soufflant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In basso le cosce sono parallele al pavimento; risali espirando."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Embaixo, as coxas ficam paralelas ao chão; suba soltando o ar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Внизу бедра параллельны полу; вверх — на выдохе."
          }
        }
      }
    },
    "Knees caving inward — keep them tracking over your feet.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Knie fallen nach innen – halte sie über den Füßen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Knees caving inward — keep them tracking over your feet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las rodillas se meten hacia dentro: mantenlas alineadas con los pies."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les genoux rentrent vers l’intérieur : garde-les dans l’axe des pieds."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ginocchia cedono verso l’interno – tienile in linea con i piedi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os joelhos caem para dentro: mantenha-os alinhados com os pés."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Колени заваливаются внутрь — держи их над стопами."
          }
        }
      }
    },
    "Heels lifting off the floor — depth matters more than speed.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fersen heben vom Boden ab – Tiefe zählt mehr als Tempo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heels lifting off the floor — depth matters more than speed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los talones se levantan del suelo: la profundidad importa más que la velocidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les talons décollent du sol : la profondeur compte plus que la vitesse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I talloni si staccano da terra – la profondità conta più della velocità."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os calcanhares saem do chão: a profundidade importa mais que a velocidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пятки отрываются от пола — глубина важнее скорости."
          }
        }
      }
    },
    "Bulgarian split squat": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulgarian Split Squat"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulgarian split squat"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentadilla búlgara"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Squat bulgare"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Squat bulgaro"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agachamento búlgaro"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Болгарские приседания"
          }
        }
      }
    },
    "Rear foot on a chair or couch behind you, front foot a stride ahead.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der hintere Fuß liegt auf einem Stuhl oder Sofa hinter dir, der vordere steht einen Schritt weiter vorn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rear foot on a chair or couch behind you, front foot a stride ahead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pie de atrás sobre una silla o un sofá; el de adelante, un paso al frente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pied arrière sur une chaise ou un canapé derrière toi ; le pied avant, un grand pas devant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il piede dietro su una sedia o sul divano, quello davanti a una falcata di distanza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pé de trás sobre uma cadeira ou sofá; o da frente, um passo adiante."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задняя стопа — на стуле или диване за спиной; передняя нога — в шаге впереди."
          }
        }
      }
    },
    "Lower straight down until the rear knee almost touches the floor.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Senk dich senkrecht ab, bis das hintere Knie den Boden fast berührt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower straight down until the rear knee almost touches the floor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja en vertical hasta que la rodilla de atrás casi toque el suelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Descends à la verticale jusqu’à ce que le genou arrière touche presque le sol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scendi in verticale finché il ginocchio dietro non sfiora il pavimento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desça na vertical até o joelho de trás quase encostar no chão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опускайся вертикально, пока заднее колено почти не коснется пола."
          }
        }
      }
    },
    "Drive up through the front heel; torso leaning slightly forward.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drück dich über die vordere Ferse hoch; der Oberkörper bleibt leicht nach vorn geneigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive up through the front heel; torso leaning slightly forward."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube empujando con el talón de delante; el torso, ligeramente inclinado al frente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remonte en poussant sur le talon avant ; le buste légèrement incliné vers l’avant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risali spingendo con il tallone davanti; il busto resta leggermente inclinato in avanti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suba empurrando com o calcanhar da frente; o tronco levemente inclinado à frente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вверх через пятку передней ноги; корпус слегка наклонен вперед."
          }
        }
      }
    },
    "Stance too short — the front knee travels far past the toes.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu kurze Schrittstellung – das vordere Knie wandert weit über die Zehen hinaus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stance too short — the front knee travels far past the toes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paso demasiado corto: la rodilla de delante se va muy por delante de la punta del pie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pas trop court : le genou avant dépasse largement la pointe du pied."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Piedi troppo vicini – il ginocchio davanti supera di molto la punta del piede."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Passo curto demais: o joelho da frente avança muito além da ponta do pé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком короткий шаг — колено уходит далеко за носок."
          }
        }
      }
    },
    "Loading the rear leg — it is only there for balance.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das hintere Bein trägt Gewicht – es ist nur fürs Gleichgewicht da."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading the rear leg — it is only there for balance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargar la pierna de atrás: solo está ahí para el equilibrio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prendre appui sur la jambe arrière : elle n’est là que pour l’équilibre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Caricare il peso sulla gamba dietro – serve solo per l’equilibrio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Jogar o peso na perna de trás: ela está ali só para o equilíbrio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опора на заднюю ногу — она нужна только для равновесия."
          }
        }
      }
    },
    "Pistol squat": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pistol Squat"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pistol squat"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentadilla pistol"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pistol Squat"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pistol squat"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agachamento pistol"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приседания «пистолетик»"
          }
        }
      }
    },
    "Stand on one leg, the other extended forward, arms out for balance.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steh auf einem Bein, das andere nach vorn gestreckt, die Arme fürs Gleichgewicht vor dir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand on one leg, the other extended forward, arms out for balance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De pie sobre una pierna, la otra extendida al frente y los brazos delante para equilibrarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Debout sur une jambe, l’autre tendue devant, les bras en avant pour l’équilibre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In piedi su una gamba, l’altra tesa in avanti, le braccia distese per l’equilibrio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em pé sobre uma perna, a outra estendida à frente e os braços à frente para equilibrar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стоя на одной ноге, вторую вытяни вперед, руки перед собой для равновесия."
          }
        }
      }
    },
    "Lower slowly until the hamstring rests on the calf, heel on the floor.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Senk dich langsam ab, bis der Oberschenkel auf der Wade aufliegt, die Ferse bleibt am Boden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower slowly until the hamstring rests on the calf, heel on the floor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja despacio hasta apoyar el muslo sobre la pantorrilla, con el talón en el suelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Descends lentement jusqu’à ce que l’arrière de la cuisse repose sur le mollet, le talon au sol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scendi lentamente finché la coscia non si appoggia sul polpaccio, il tallone resta a terra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desça devagar até a coxa encostar na panturrilha, com o calcanhar no chão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Медленно садись до касания бедром икры, пятка на полу."
          }
        }
      }
    },
    "Stand up without your hands; start with a doorframe assist if needed.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steh ohne Hände auf; anfangs kannst du dich am Türrahmen festhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand up without your hands; start with a doorframe assist if needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube sin ayudarte con las manos; al principio puedes sujetarte al marco de una puerta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relève-toi sans les mains ; au début, tu peux t’aider d’un encadrement de porte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alzati senza aiutarti con le mani; all’inizio puoi tenerti allo stipite di una porta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suba sem usar as mãos; no começo dá para se apoiar no batente da porta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вверх без помощи рук; сначала можно придерживаться за дверной косяк."
          }
        }
      }
    },
    "Dropping down without control — the descent must be slow.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sich unkontrolliert fallen lassen – der Weg nach unten muss langsam sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dropping down without control — the descent must be slow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejarte caer sin control: el descenso tiene que ser lento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Te laisser tomber sans contrôle : la descente doit être lente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lasciarsi cadere senza controllo – la discesa deve essere lenta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cair sem controle: a descida precisa ser lenta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Падение вниз без контроля — опускайся медленно и подконтрольно."
          }
        }
      }
    },
    "Knee drifting sideways — keep it tracking over the foot.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
