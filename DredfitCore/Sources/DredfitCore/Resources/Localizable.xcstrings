          "stringUnit": {
            "state": "translated",
            "value": "Задержись внизу на честные 2 секунды, колено у пола."
          }
        }
      }
    },
    "Explode up into the next switch — pause every landing.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spring explosiv in den nächsten Beinwechsel – stoppe bei jeder Landung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explode up into the next switch — pause every landing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta de forma explosiva cambiando de pierna: pausa en cada aterrizaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saute de façon explosive vers le changement suivant : marque un temps d’arrêt à chaque réception."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esplodi verso l’alto nel cambio successivo – fermati a ogni atterraggio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salte explosivo trocando as pernas: pausa em cada aterrissagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Взрывно выпрыгни со сменой ног — пауза на каждом приземлении."
          }
        }
      }
    },
    "Skipping the pause — hold an honest 2 seconds at the bottom.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du lässt den Stopp aus – halte unten ehrliche 2 Sekunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skipping the pause — hold an honest 2 seconds at the bottom."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Saltarte la pausa: aguanta 2 segundos completos abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu zappes le temps d’arrêt : tiens 2 vraies secondes en bas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salti il fermo – tieni 2 secondi veri nella posizione bassa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pular a pausa: segure 2 segundos completos embaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пауза пропускается — держи честные 2 секунды внизу."
          }
        }
      }
    },
    "Shallow landings — the knee comes close to the floor each rep.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu flache Landungen – das Knie kommt in jeder Wiederholung nah an den Boden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shallow landings — the knee comes close to the floor each rep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aterrizajes cortos: la rodilla baja cerca del suelo en cada repetición."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réceptions trop hautes : le genou descend près du sol à chaque répétition."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Atterraggi poco profondi – il ginocchio arriva vicino a terra a ogni ripetizione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aterrissagens curtas: o joelho desce perto do chão em cada repetição."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неглубокие приземления — колено должно почти касаться пола в каждом повторе."
          }
        }
      }
    },
    "Knee plank": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plank auf den Knien"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Knee plank"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Plancha de rodillas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planche sur les genoux"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Plank sulle ginocchia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prancha de joelhos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Планка на коленях"
          }
        }
      }
    },
    "Forearms on the floor, elbows under the shoulders, knees down.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterarme auf dem Boden, Ellenbogen unter den Schultern, Knie abgesetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forearms on the floor, elbows under the shoulders, knees down."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antebrazos en el suelo, codos bajo los hombros, rodillas apoyadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant-bras au sol, coudes sous les épaules, genoux posés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avambracci a terra, gomiti sotto le spalle, ginocchia appoggiate."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Antebraços no chão, cotovelos sob os ombros, joelhos apoiados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предплечья на полу, локти под плечами, колени на полу."
          }
        }
      }
    },
    "Head to knees — one straight line; belly pulled in.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vom Kopf bis zu den Knien eine gerade Linie; Bauch eingezogen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Head to knees — one straight line; belly pulled in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De la cabeza a las rodillas, una línea recta; el abdomen metido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De la tête aux genoux, une seule ligne droite ; le ventre rentré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalla testa alle ginocchia una linea retta; pancia in dentro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Da cabeça aos joelhos, uma linha reta; a barriga contraída."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "От макушки до колен — прямая линия; живот подтянут."
          }
        }
      }
    },
    "Breathe steadily and hold for the planned time.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Atme gleichmäßig und halte die geplante Zeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Breathe steadily and hold for the planned time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Respira de forma regular y aguanta el tiempo previsto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Respire régulièrement et tiens le temps prévu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Respira in modo regolare e tieni la posizione per il tempo previsto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Respire de forma regular e segure pelo tempo previsto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дыши ровно и держи запланированное время."
          }
        }
      }
    },
    "Hips sagging — tuck the pelvis slightly.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Hüfte hängt durch – richte das Becken leicht auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hips sagging — tuck the pelvis slightly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cadera se hunde: bascula un poco la pelvis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les hanches s’affaissent : bascule légèrement le bassin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il bacino scende – portalo leggermente in retroversione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O quadril afunda: encaixe a pelve levemente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Таз провисает — слегка подкрути его на себя."
          }
        }
      }
    },
    "Shoulders at the ears — push the floor away, keep the neck long.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schultern wandern zu den Ohren – drück den Boden weg, halte den Nacken lang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shoulders at the ears — push the floor away, keep the neck long."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hombros pegados a las orejas: empuja el suelo y alarga el cuello."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les épaules montent vers les oreilles : repousse le sol, allonge la nuque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le spalle salgono verso le orecchie – spingi via il pavimento e tieni il collo lungo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ombros colados nas orelhas: empurre o chão e alongue o pescoço."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плечи у ушей — толкай пол от себя, шея длинная."
          }
        }
      }
    },
    "Plank": {
      "extractionState": "manual",
      "localizations": {
