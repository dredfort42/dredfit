    "Take a plank on the forearms, elbows well ahead of the shoulders.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh in die Plank auf den Unterarmen, die Ellenbogen deutlich vor den Schultern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a plank on the forearms, elbows well ahead of the shoulders."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponte en plancha sobre los antebrazos, con los codos bastante por delante de los hombros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mets-toi en planche sur les avant-bras, les coudes bien en avant des épaules."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettiti in plank sugli avambracci, con i gomiti ben avanti rispetto alle spalle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fique em prancha sobre os antebraços, com os cotovelos bem à frente dos ombros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встань в планку на предплечьях, локти заметно впереди плеч."
          }
        }
      }
    },
    "Keep one straight line from head to heels, glutes tight.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte eine gerade Linie vom Kopf bis zu den Fersen, der Po bleibt angespannt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep one straight line from head to heels, glutes tight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén una línea recta de la cabeza a los talones, con los glúteos apretados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde une ligne droite de la tête aux talons, les fesses serrées."
          }
        },
        "it": {
          "stringUnit": {
