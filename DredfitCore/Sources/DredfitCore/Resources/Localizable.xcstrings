          }
        }
      }
    },
    "Rise onto the ball of the foot as high as possible, pause for a second.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drück dich so hoch wie möglich auf den Fußballen und halte eine Sekunde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rise onto the ball of the foot as high as possible, pause for a second."
          }
