            "value": "Боковая планка «звезда»"
          }
        }
      }
    },
    "From a side plank, raise the top leg and the top arm at once.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heb aus der seitlichen Plank gleichzeitig das obere Bein und den oberen Arm an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From a side plank, raise the top leg and the top arm at once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde la plancha lateral, sube a la vez la pierna y el brazo de arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depuis la planche latérale, lève en même temps la jambe et le bras du dessus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dal plank laterale, solleva insieme la gamba e il braccio superiori."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Da prancha lateral, suba ao mesmo tempo a perna e o braço de cima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Из боковой планки подними верхнюю ногу и верхнюю руку одновременно."
          }
        }
      }
    },
    "The body forms a star: straight line plus raised limbs.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Körper bildet einen Stern: gerade Linie plus angehobener Arm und angehobenes Bein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The body forms a star: straight line plus raised limbs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cuerpo forma una estrella: la línea recta más las extremidades levantadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le corps forme une étoile : la ligne droite plus le bras et la jambe levés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il corpo forma una stella: la linea retta più gli arti sollevati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O corpo forma uma estrela: a linha reta mais os membros levantados."
