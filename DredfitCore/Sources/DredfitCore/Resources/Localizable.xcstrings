          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогиб в пояснице — не выталкивай таз выше прямой линии."
          }
        }
      }
    },
    "Pushing through the toes — keep the weight on the heels.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über die Zehen drücken – das Gewicht bleibt auf den Fersen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pushing through the toes — keep the weight on the heels."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empujar con las puntas de los pies: el peso va en los talones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pousser avec la pointe des pieds : le poids reste sur les talons."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spingere con le punte dei piedi – il peso resta sui talloni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Empurrar com as pontas dos pés: o peso fica nos calcanhares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Толчок через носки — вес должен быть на пятках."
          }
        }
      }
    },
    "Single-leg glute bridge": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einbeiniges Beckenheben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Single-leg glute bridge"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puente de glúteos a una pierna"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pont fessier à une jambe"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponte glutei a una gamba"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponte de glúteos unilateral"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ягодичный мостик на одной ноге"
          }
        }
      }
    },
    "Lie on your back, one foot near the glutes, the other leg extended.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg dich auf den Rücken, ein Fuß nah am Gesäß, das andere Bein gestreckt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lie on your back, one foot near the glutes, the other leg extended."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acuéstate boca arriba, con un pie cerca de los glúteos y la otra pierna extendida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allonge-toi sur le dos, un pied près des fessiers, l’autre jambe tendue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdraiati sulla schiena, un piede vicino ai glutei, l’altra gamba distesa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deite-se de costas, com um pé perto dos glúteos e a outra perna estendida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лежа на спине, одна стопа у ягодиц, вторая нога вытянута."
          }
        }
      }
    },
    "Lift the hips with one leg to a straight line, keeping the pelvis level.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heb die Hüfte mit einem Bein bis zur geraden Linie; das Becken bleibt waagerecht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lift the hips with one leg to a straight line, keeping the pelvis level."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube la cadera con una sola pierna hasta formar una línea recta, manteniendo la pelvis nivelada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soulève le bassin sur une jambe jusqu’à la ligne droite, en le gardant bien horizontal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solleva il bacino con una gamba sola fino a formare una linea retta, senza inclinarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suba o quadril com uma perna só até formar uma linha reta, mantendo a pelve nivelada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опираясь на одну ногу, подними таз до прямой линии и держи его ровно."
          }
        }
      }
    },
    "Pause a second at the top, lower slowly.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halt oben eine Sekunde, dann senk die Hüfte langsam ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause a second at the top, lower slowly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un segundo de pausa arriba y baja despacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reste une seconde en haut, puis redescends lentement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermati un secondo in alto, poi scendi lentamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um segundo de pausa em cima e desça devagar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Секунда паузы вверху, медленно вниз."
          }
        }
      }
    },
    "Pelvis tilting sideways — keep both hip bones pointing at the ceiling.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Becken kippt zur Seite – beide Hüftknochen zeigen zur Decke."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelvis tilting sideways — keep both hip bones pointing at the ceiling."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pelvis se inclina hacia un lado: los dos huesos de la cadera miran al techo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bassin penche d’un côté : les deux hanches pointent vers le plafond."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il bacino si inclina di lato – tieni le due ossa dell’anca rivolte al soffitto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pelve inclina para o lado: os dois ossos do quadril apontam para o teto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Таз перекашивается — обе тазовые кости смотрят в потолок."
          }
        }
      }
    },
    "Helping with the free leg — it stays out of the movement.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit dem freien Bein nachhelfen – es macht bei der Bewegung nicht mit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Helping with the free leg — it stays out of the movement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayudarte con la pierna libre: no participa en el movimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’aider de la jambe libre : elle ne participe pas au mouvement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aiutarsi con la gamba libera – non partecipa al movimento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajudar com a perna livre: ela não participa do movimento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помощь свободной ногой — она не участвует в движении."
          }
        }
      }
    },
    "Single-leg Romanian deadlift": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einbeiniges rumänisches Kreuzheben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Single-leg Romanian deadlift"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Peso muerto rumano a una pierna"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soulevé de terre roumain à une jambe"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stacco rumeno a una gamba"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Levantamento terra romeno unilateral"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Румынская тяга на одной ноге"
          }
        }
      }
    },
    "Stand on one leg with a soft knee; hinge forward from the hips with a flat back.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell dich auf ein Bein, das Knie leicht gebeugt; kipp den Oberkörper mit geradem Rücken aus der Hüfte nach vorn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand on one leg with a soft knee; hinge forward from the hips with a flat back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De pie sobre una pierna con la rodilla algo flexionada, inclínate al frente desde la cadera con la espalda recta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Debout sur une jambe, le genou souple ; bascule le buste vers l’avant depuis les hanches, le dos bien plat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In piedi su una gamba, ginocchio morbido; piegati in avanti dall’anca con la schiena dritta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em pé sobre uma perna com o joelho levemente flexionado, incline para a frente a partir do quadril com a coluna reta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стоя на одной ноге с мягким коленом, наклоняйся вперед с прямой спиной."
          }
        }
      }
    },
    "The free leg extends back; torso and leg form one line, hands reaching toward the floor.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das freie Bein streckt sich nach hinten; Oberkörper und Bein bilden eine Linie, die Hände gehen Richtung Boden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The free leg extends back; torso and leg form one line, hands reaching toward the floor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pierna libre se va hacia atrás; torso y pierna forman una línea, las manos bajan hacia el suelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La jambe libre part vers l’arrière ; buste et jambe forment une ligne, les mains descendent vers le sol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La gamba libera si allunga indietro; busto e gamba formano una linea, le mani scendono verso il pavimento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A perna livre vai para trás; tronco e perna formam uma linha, as mãos descem em direção ao chão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свободная нога уходит назад; корпус и нога — одна линия, руки к полу."
          }
        }
      }
    },
    "Stand back up by squeezing the glute of the standing leg.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richte dich wieder auf und spann dabei das Gesäß des Standbeins an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand back up by squeezing the glute of the standing leg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a subir apretando el glúteo de la pierna de apoyo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redresse-toi en serrant le fessier de la jambe d’appui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risali contraendo il gluteo della gamba d’appoggio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Volte a subir apertando o glúteo da perna de apoio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поднимись обратно, напрягая ягодицу опорной ноги."
          }
        }
      }
    },
    "Rounding the back — keep the shoulder blades set, hinge from the hips.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Runder Rücken – halt die Schulterblätter zusammen und beug dich aus der Hüfte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rounding the back — keep the shoulder blades set, hinge from the hips."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espalda redondeada: mantén las escápulas firmes y bascula desde la cadera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos arrondi : garde les omoplates serrées et bascule depuis les hanches."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incurvare la schiena – tieni le scapole ferme e piegati dall’anca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coluna arredondada: mantenha as escápulas firmes e incline a partir do quadril."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Круглая спина — держи лопатки собранными, наклон из таза."
          }
        }
      }
    },
    "Pelvis rotating open — keep the hips square to the floor.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Becken dreht sich auf – halt die Hüfte parallel zum Boden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelvis rotating open — keep the hips square to the floor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pelvis se abre: mantén las caderas paralelas al suelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bassin s’ouvre : garde les hanches parallèles au sol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il bacino si apre di lato – tienilo parallelo al pavimento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pelve abre para o lado: mantenha os quadris paralelos ao chão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разворот таза в сторону — держи таз ровно, обе тазовые кости смотрят в пол."
          }
        }
      }
    },
    "Sliding leg curl": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sliding Leg Curl"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sliding leg curl"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Curl femoral deslizante"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg curl glissé"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sliding leg curl"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Curl femoral deslizante"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сгибание ног скольжением"
          }
        }
      }
    },
    "Lie on your back, heels on a towel on a smooth floor, hips lifted.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg dich auf den Rücken, die Fersen auf einem Handtuch auf glattem Boden, und heb die Hüfte an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lie on your back, heels on a towel on a smooth floor, hips lifted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acuéstate boca arriba, con los talones sobre una toalla en suelo liso y la cadera elevada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allonge-toi sur le dos, les talons sur une serviette posée sur un sol lisse, le bassin décollé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdraiati sulla schiena su un pavimento liscio, i talloni su un asciugamano, il bacino sollevato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deite-se de costas, com os calcanhares sobre uma toalha em piso liso e o quadril elevado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лежа на спине, пятки на полотенце на гладком полу, таз поднят."
          }
        }
      }
    },
    "Slide the heels away until the legs are almost straight, hips stay up.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schieb die Fersen von dir weg, bis die Beine fast gestreckt sind; die Hüfte bleibt oben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide the heels away until the legs are almost straight, hips stay up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza los talones hacia fuera hasta casi estirar las piernas; la cadera no baja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais glisser les talons vers l’avant jusqu’à ce que les jambes soient presque tendues ; le bassin ne descend pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai scivolare i talloni in avanti finché le gambe non sono quasi tese; il bacino resta alto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize os calcanhares para longe até as pernas quase esticarem; o quadril não desce."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скользи пятками от себя почти до прямых ног, таз не опускается."
          }
        }
      }
    },
    "Pull the heels back toward the glutes — that's one rep.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh die Fersen zurück zum Gesäß – das ist eine Wiederholung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull the heels back toward the glutes — that's one rep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trae los talones de vuelta hacia los glúteos: eso es una repetición."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramène les talons vers les fessiers : ça fait une répétition."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riporta i talloni verso i glutei – questa è una ripetizione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Traga os calcanhares de volta em direção aos glúteos: isso é uma repetição."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
