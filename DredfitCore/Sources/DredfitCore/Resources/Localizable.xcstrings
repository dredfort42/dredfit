    "Lift the hips until knees, hips and shoulders form one straight line.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heb die Hüfte, bis Knie, Hüfte und Schultern eine gerade Linie bilden."
