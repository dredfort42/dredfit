            "state": "translated",
            "value": "Дыши ровно и держи запланированное время."
          }
        }
      }
    },
    "Hips sagging — tuck the pelvis slightly.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Hüfte hängt durch – richte das Becken leicht auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hips sagging — tuck the pelvis slightly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cadera se hunde: bascula un poco la pelvis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les hanches s’affaissent : bascule légèrement le bassin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il bacino scende – portalo leggermente in retroversione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O quadril afunda: encaixe a pelve levemente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Таз провисает — слегка подкрути его на себя."
          }
        }
      }
    },
    "Shoulders at the ears — push the floor away, keep the neck long.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schultern wandern zu den Ohren – drück den Boden weg, halte den Nacken lang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shoulders at the ears — push the floor away, keep the neck long."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hombros pegados a las orejas: empuja el suelo y alarga el cuello."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les épaules montent vers les oreilles : repousse le sol, allonge la nuque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le spalle salgono verso le orecchie – spingi via il pavimento e tieni il collo lungo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ombros colados nas orelhas: empurre o chão e alongue o pescoço."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плечи у ушей — толкай пол от себя, шея длинная."
          }
        }
      }
    },
    "Plank": {
      "extractionState": "manual",
      "localizations": {
        "de": {
