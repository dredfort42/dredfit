    "Lie on your back, feet close to the glutes hip-width apart, arms at your sides.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg dich auf den Rücken, die Füße hüftbreit nah am Gesäß, die Arme neben dem Körper."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lie on your back, feet close to the glutes hip-width apart, arms at your sides."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acuéstate boca arriba, con los pies cerca de los glúteos al ancho de las caderas y los brazos a los lados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
