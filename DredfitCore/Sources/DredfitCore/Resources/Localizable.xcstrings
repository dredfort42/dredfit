        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Из положения стоя шагни назад, опустив заднее колено почти до пола."
          }
        }
      }
    },
    "The front shin stays near vertical; weight on the front heel.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das vordere Schienbein bleibt fast senkrecht; das Gewicht liegt auf der vorderen Ferse."
