          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In piedi su una gamba, con la punta del piede sul bordo dello scalino."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em pé sobre uma perna, com a ponta do pé na borda de um degrau."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стоя на одной ноге, носок на краю ступеньки."
          }
        }
      }
    },
    "Lower the heel below the step level, feel the stretch.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Senk die Ferse unter die Stufenkante, spür die Dehnung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower the heel below the step level, feel the stretch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja el talón por debajo del escalón y nota el estiramiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Descends le talon plus bas que la marche, sens l’étirement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbassa il tallone sotto il livello dello scalino, senti l’allungamento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desça o calcanhar abaixo do degrau e sinta o alongamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опусти пятку ниже уровня ступеньки, почувствуй растяжение."
          }
        }
      }
    },
    "Rise as high as possible, pause a second, lower for 3 seconds.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drück dich so hoch wie möglich, halte eine Sekunde, senk dich in 3 Sekunden ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rise as high as possible, pause a second, lower for 3 seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube todo lo que puedas, pausa de un segundo y baja en 3 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Monte le plus haut possible, une seconde de pause, redescends en 3 secondes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sollevati il più in alto possibile, un secondo di pausa, scendi in 3 secondi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suba o máximo possível, pausa de um segundo e desça em 3 segundos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поднимись максимально высоко, секунда паузы, вниз 3 секунды."
          }
        }
      }
    },
    "Short bottom range — the heel must drop below the step.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu wenig Weg nach unten – die Ferse muss unter die Stufenkante."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Short bottom range — the heel must drop below the step."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Poco recorrido abajo: el talón tiene que bajar por debajo del escalón."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas assez d’amplitude en bas : le talon doit descendre plus bas que la marche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poca ampiezza in basso – il tallone deve scendere sotto lo scalino."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouca amplitude embaixo: o calcanhar precisa descer abaixo do degrau."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Короткая нижняя фаза — пятка должна уходить ниже ступеньки."
          }
        }
      }
    },
    "Bouncing out of the stretch — pause briefly at the bottom too.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wippen aus der Dehnung – halte auch unten kurz inne."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bouncing out of the stretch — pause briefly at the bottom too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebotar desde el estiramiento: haz también una pausa corta abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebondir dans l’étirement : marque aussi une courte pause en bas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Molleggiare nell’allungamento – fai una breve pausa anche in basso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quicar ao sair do alongamento: faça também uma pausa curta embaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пружинишь в растяжке — внизу тоже короткая пауза."
          }
        }
      }
    },
