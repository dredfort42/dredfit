    "From a push-up position, lift the hips high — the body forms an inverted V.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heb aus der Liegestützposition die Hüfte weit nach oben – der Körper bildet ein umgekehrtes V."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From a push-up position, lift the hips high — the body forms an inverted V."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde la posición de flexión, sube mucho la cadera: el cuerpo forma una V invertida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depuis la position de pompes, monte le bassin bien haut : le corps forme un V inversé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalla posizione delle flessioni, porta il bacino ben in alto – il corpo forma una V rovesciata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Da posição de flexão, suba bem o quadril: o corpo forma um V invertido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Из упора лежа подними таз вверх — тело углом, как перевернутая V."
          }
        }
      }
    },
    "Bend the elbows, lowering the top of the head toward the floor between the hands.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beug die Ellenbogen und senk den Scheitel zwischen den Händen Richtung Boden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bend the elbows, lowering the top of the head toward the floor between the hands."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobla los codos bajando la coronilla hacia el suelo, entre las manos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plie les coudes en descendant le sommet du crâne vers le sol, entre les mains."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Piega i gomiti, abbassando la sommità della testa verso il pavimento tra le mani."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobre os cotovelos descendo o topo da cabeça em direção ao chão, entre as mãos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сгибай локти, опуская макушку к полу между ладонями."
          }
        }
      }
    },
    "Press back up without dropping the hips.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drück dich wieder hoch, ohne die Hüfte sinken zu lassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press back up without dropping the hips."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empuja hacia arriba sin dejar caer la cadera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repousse-toi vers le haut sans laisser retomber le bassin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spingi verso l’alto senza far scendere il bacino."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Empurre para cima sem deixar o quadril cair."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выжми себя вверх, не опуская таз."
          }
        }
      }
    },
    "Hips dropping as the arms bend — keep the V shape.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Hüfte sinkt beim Beugen der Arme – halte die V-Form."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hips dropping as the arms bend — keep the V shape."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cadera baja al doblar los brazos: mantén la forma de V."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bassin descend quand les bras se plient : garde la forme en V."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il bacino scende mentre le braccia si piegano – mantieni la forma a V."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O quadril desce quando os braços dobram: mantenha o formato de V."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Таз опускается при сгибании рук — сохраняй форму буквы V."
          }
        }
      }
    },
    "Bumping the head on the floor — lower slowly, with control.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kopf schlägt auf dem Boden auf – senk dich langsam und kontrolliert ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bumping the head on the floor — lower slowly, with control."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Golpear la cabeza contra el suelo: baja despacio, con control."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tête cogne le sol : descends lentement, en douceur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La testa sbatte sul pavimento – scendi lentamente e con controllo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bater a cabeça no chão: desça devagar, com controle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голова бьется об пол — опускайся медленно, на контроле."
          }
        }
      }
    },
    "Wall handstand push-up": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Handstand-Liegestütze an der Wand"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wall handstand push-up"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flexión en parada de manos contra la pared"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pompes en poirier au mur"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Flessioni in verticale al muro"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Flexão em parada de mão na parede"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отжимания в стойке у стены"
          }
        }
      }
    },
    "Getting in: face away from the wall, hands a palm's length from it, and walk your feet up until your heels rest on it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstieg: mit dem Rücken zur Wand, Hände eine Handbreit davor, dann mit den Füßen die Wand hochlaufen, bis die Fersen aufliegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Getting in: face away from the wall, hands a palm's length from it, and walk your feet up until your heels rest on it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrada: de espaldas a la pared, manos a un palmo de ella, y sube caminando con los pies hasta apoyar los talones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrée : dos au mur, mains à une paume de distance, puis monte les pieds le long du mur jusqu'à poser les talons."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingresso: schiena al muro, mani a un palmo da esso, e cammina con i piedi sul muro finché i talloni non si appoggiano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrada: de costas para a parede, mãos a um palmo dela, e suba com os pés pela parede até apoiar os calcanhares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход: спиной к стене, ладони в ладони от неё, и поднимайся ногами по стене, пока пятки не лягут на неё."
          }
        }
      }
    },
    "Bend the elbows slowly, lowering the top of the head toward the floor.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beug die Ellenbogen langsam und senk den Scheitel Richtung Boden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bend the elbows slowly, lowering the top of the head toward the floor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobla los codos despacio, bajando la coronilla hacia el suelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plie lentement les coudes en descendant le sommet du crâne vers le sol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Piega i gomiti lentamente, abbassando la sommità della testa verso il pavimento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobre os cotovelos devagar, descendo o topo da cabeça em direção ao chão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Медленно сгибай локти, опуская макушку к полу."
          }
        }
      }
    },
    "Getting out: walk the feet back down the wall. If you have to bail mid-rep, turn your head to one side and step over — never collapse straight down.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausstieg: die Füße an der Wand wieder hinunterlaufen. Musst du mitten in der Wiederholung abbrechen, dreh den Kopf zur Seite und steig seitlich ab – sacke nie gerade nach unten zusammen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Getting out: walk the feet back down the wall. If you have to bail mid-rep, turn your head to one side and step over — never collapse straight down."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salida: baja los pies por la pared. Si tienes que abandonar a media repetición, gira la cabeza hacia un lado y pasa por encima; nunca te desplomes en línea recta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortie : redescends les pieds le long du mur. S'il faut abandonner en pleine répétition, tourne la tête sur le côté et enjambe — ne t'effondre jamais à la verticale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uscita: riporta i piedi giù lungo il muro. Se devi interrompere a metà ripetizione, gira la testa di lato e scavalca: mai accasciarti in linea retta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Saída: desça os pés pela parede. Se precisar abortar no meio da repetição, vire a cabeça para o lado e passe por cima — nunca desabe em linha reta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сход: спусти ноги по стене обратно. Если приходится сойти на середине повтора — поверни голову вбок и перешагни, но не складывайся вниз."
          }
        }
      }
    },
    "Arching the lower back — keep the core and glutes tight.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hohlkreuz – halte Rumpf und Po angespannt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arching the lower back — keep the core and glutes tight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arqueo en la zona lumbar: mantén el abdomen y los glúteos apretados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bas du dos se cambre : garde les abdos et les fesses serrés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La zona lombare si inarca – tieni core e glutei contratti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arco na lombar: mantenha o core e os glúteos contraídos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогиб в пояснице — держи мышцы корпуса и ягодицы в напряжении."
          }
        }
      }
    },
    "Elbows drifting outward — track them forward and down.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ellenbogen wandern nach außen – führ sie nach vorn und unten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Elbows drifting outward — track them forward and down."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los codos se abren hacia fuera: llévalos hacia adelante y abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les coudes s’écartent vers l’extérieur : guide-les vers l’avant et vers le bas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I gomiti si aprono verso l’esterno – guidali in avanti e verso il basso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os cotovelos abrem para fora: conduza-os para a frente e para baixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локти разъезжаются в стороны — веди их вперед-вниз."
          }
        }
      }
    },
    "Feet-elevated pike push-up": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pike-Liegestütz mit erhöhten Füßen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feet-elevated pike push-up"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flexión en pica con pies elevados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pompes en pique, pieds surélevés"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Piegamenti a pike con piedi rialzati"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Flexão em pique com pés elevados"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отжимания «щучкой» с ногами на возвышении"
          }
        }
      }
    },
    "Put your feet on a chair or a low bed and walk your hands back into a steep inverted V.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell die Füße auf einen Stuhl oder ein niedriges Bett und lauf mit den Händen zurück in ein steiles umgekehrtes V."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put your feet on a chair or a low bed and walk your hands back into a steep inverted V."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apoya los pies en una silla o una cama baja y camina con las manos hasta formar una V invertida pronunciada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose les pieds sur une chaise ou un lit bas et rapproche les mains pour former un V inversé bien marqué."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appoggia i piedi su una sedia o un letto basso e cammina con le mani fino a formare una V rovesciata ripida."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apoie os pés numa cadeira ou cama baixa e caminhe com as mãos até formar um V invertido bem fechado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставь ноги на стул или низкую кровать и подставь руки ближе — тело в крутой букве V."
          }
        }
      }
    },
    "Press back up; the higher the feet, the closer this gets to a handstand.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drück dich wieder hoch – je höher die Füße, desto näher am Handstand."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press back up; the higher the feet, the closer this gets to a handstand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empuja hasta arriba; cuanto más altos los pies, más se parece al pino."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repousse jusqu'en haut ; plus les pieds sont hauts, plus on se rapproche de l'ATR."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spingi di nuovo su: più alti sono i piedi, più ci si avvicina alla verticale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Empurre de volta para cima; quanto mais altos os pés, mais perto fica da parada de mão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выжми обратно вверх: чем выше ноги, тем ближе это к стойке на руках."
          }
        }
      }
    },
    "Hips sagging toward the floor — keep the V sharp, weight over the hands.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Hüfte sinkt ab – halte das V spitz, das Gewicht über den Händen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hips sagging toward the floor — keep the V sharp, weight over the hands."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cadera se hunde: mantén la V cerrada y el peso sobre las manos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les hanches s'affaissent : garde le V bien fermé, le poids au-dessus des mains."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il bacino scende: tieni la V stretta, il peso sopra le mani."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O quadril afunda: mantenha o V fechado, com o peso sobre as mãos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Таз проваливается вниз — держи букву V острой, вес над ладонями."
          }
        }
      }
    },
    "Starting too high — if the head cannot reach the floor with control, lower the feet.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu hoch angefangen – wenn der Kopf nicht kontrolliert den Boden erreicht, stell die Füße tiefer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting too high — if the head cannot reach the floor with control, lower the feet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empezar demasiado alto: si la cabeza no llega al suelo con control, baja los pies."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Départ trop haut : si la tête n'atteint pas le sol sous contrôle, baisse les pieds."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Partenza troppo alta: se la testa non arriva a terra sotto controllo, abbassa i piedi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Começar alto demais: se a cabeça não alcança o chão com controle, abaixe os pés."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком высокая опора — если голова не доходит до пола под контролем, опусти ноги ниже."
          }
        }
      }
    },
    "Static lunge": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Statische Ausfallschritte"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Static lunge"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Zancada estática"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fentes statiques"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Affondi statici"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Afundo estático"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выпады на месте"
          }
        }
      }
    },
    "Step into a lunge stance and stay in it for the whole set.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach einen Ausfallschritt und bleib den ganzen Satz in dieser Position."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step into a lunge stance and stay in it for the whole set."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Colócate en posición de zancada y quédate en ella toda la serie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Place-toi en position de fente et restes-y pendant toute la série."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettiti in posizione di affondo e restaci per tutta la serie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assuma a posição de afundo e permaneça nela durante toda a série."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шагни в позицию выпада и оставайся в ней весь подход."
          }
        }
      }
    },
    "Drive up through the front heel, torso upright.": {
      "extractionState": "manual",
      "localizations": {
