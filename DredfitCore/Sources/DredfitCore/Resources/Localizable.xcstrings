    },
    "The front shin stays near vertical; weight on the front heel.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das vordere Schienbein bleibt fast senkrecht; das Gewicht liegt auf der vorderen Ferse."
