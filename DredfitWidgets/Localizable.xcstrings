    "Workout, done, or rest day — at a glance.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Training, „Geschafft“ oder Ruhetag – auf einen Blick."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Workout, done, or rest day — at a glance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrenamiento, «hecho» o día de descanso: todo de un vistazo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Séance, « C’est fait » ou jour de repos — en un coup d’œil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allenamento, “fatto” o giorno di riposo – a colpo d’occhio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Treino, “feito” ou dia de descanso — tudo num relance."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренировка, «выполнено» или день отдыха — одним взглядом."
          }
        }
      }
    },
