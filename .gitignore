# Xcode / Swift
#
# GitHub's Swift template, trimmed to what this project actually uses: no
# CocoaPods, no Carthage, no fastlane, no playgrounds. Add a section back if a
# tool arrives.

## Per-user Xcode state
xcuserdata/
*.moved-aside

## Build output
DerivedData/
build/
.build/
*.hmap
*.xcresult

## Packaging and symbols
*.ipa
*.xcarchive
*.dSYM
*.dSYM.zip

## Signing material and secrets — never in the repo
*.p12
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
.env

# Swift Package Manager
#
# Package.resolved stays tracked: the day DredfitCore takes a dependency, the
# pinned versions have to travel with the repo. DredfitCore/.swiftpm holds a
# shared scheme that is tracked too — only the per-user data under it is
# ignored, by the xcuserdata rule above.
.swiftpm/configuration/

# macOS
.DS_Store

# Python tooling (scripts/, sitegen/, appstore/tools/)
__pycache__/
*.py[cod]
.venv/

# AI assistants and coding agents
#
# Per-project state, caches, chat history and local settings of AI tooling.
# None of it belongs to the app; each developer's setup stays their own.
.aider*
.amazonq/
.augment/
.claude/
.cline/
.clinerules/
.codeium/
.codex/
.cody/
.continue/
.copilot/
.crush/
.cursor/
.factory/
.gemini/
.goose/
.junie/
.kilocode/
.opencode/
.openai/
.qodo/
.roo/
.serena/
.specstory/
.tabnine/
.trae/
.windsurf/

# Local-only working material
#
# reference/         engine reference chain: spec, verifier, golden generator
# instructions/      agent task docs, backlog, glossary, release regulation
# sitegen/           site generator; its published output in docs/ is tracked
# release_texts_*.md App Store and TestFlight texts for the release in flight
reference/
instructions/
sitegen/
release_texts_*.md
