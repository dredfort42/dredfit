<?xml version="1.0" encoding="utf-8"?>
<!-- The home-screen widget (widgets/TodayStatusWidget.kt): ONE resizable
     widget for iOS's small, medium and large (android/README.md says why).
     - Default 4×2, the medium: it shows the most of the iOS families at the
       size a widget is most often given (targetCell*, Android 12+; minWidth
       and minHeight say the same to Android 10–11).
     - Down to 2×2, the small (minResize*); up to anything, the large from a
       tall four-column one. The layouts are drawn up front (responsive), so
       a resize needs no app process.
     - No periodic update (0): the app redraws after every change and at the
       next local midnight (widgets/WidgetCenter.kt) — a timer would wake the
       phone to draw the same snapshot.
     - Home screen only. Android 16's lock-screen hub takes home-screen widgets
       by default; nothing here opts out (`not_keyguard`, owner decision
       11.10.2026), and a tap there asks for the unlock first, because the
       app is not shown when locked.
     - The picker's preview: on Android 15+ the generated one, the person's
       own day (widgets/WidgetCenter.kt); on 10–14, and on 15+ before the app
       has set one, `previewImage` — the medium on a neutral week, in English,
       light (owner decision 11.10.2026; WidgetScreenshots
       #captureThePreviewImage renders it). No `previewLayout`: from Android 12
       it would win over the image. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widgets_workout_done_or_rest_day_at_a_glance_0213893e"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:previewImage="@drawable/widget_preview_image"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
