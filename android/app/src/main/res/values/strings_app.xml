    <string name="app_warmup_armcircles_step1_15c35634">Circle straight arms forward — big, slow circles.</string>
    <string name="app_warmup_armcircles_step2_5cbad61a">Halfway through, switch direction and circle backward.</string>
    <string name="app_warmup_catcow_step1_467bcdb5">On all fours: exhale, round the back and tuck the chin.</string>
    <string name="app_warmup_catcow_step2_a1bef157">Inhale, arch gently and look slightly up — one slow wave per breath.</string>
    <string name="app_warmup_halfsquats_step1_5710563f">Sit back to half depth, arms reaching forward for balance.</string>
    <string name="app_warmup_halfsquats_step2_d5b871bc">Heels stay down; rise smoothly without locking the knees.</string>
