<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon's glyph: store/appstore/icons/final_light.svg, the iOS
     icon, circle for circle in its colours. The iOS 1024 canvas is the
     whole masked tile, which on Android is the inner 72 dp of the 108 dp
     layer — so the viewport is 1536 units and the art sits 256 in, at its
     own coordinates. Its farthest point, the ring's outer
     edge, lands 30.3 dp from the centre: inside the guideline's 66 dp safe
     circle (AdaptiveIconDrawable's SAFEZONE_SCALE, 66/72). Pixel's
     four-sided cookie mask pinches into that circle at the sides and leaves
     1–2 dp beside the outer dots (API 37 emulator) — the cost of keeping
     the iOS proportions. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1536"
    android:viewportHeight="1536">
    <group
        android:translateX="256"
        android:translateY="256">
        <!-- Done. -->
        <path
            android:fillColor="#FF111214"
            android:pathData="M94,512a112,112 0,1 0,224 0a112,112 0,1 0,-224 0z" />
        <!-- Today. -->
        <path
            android:fillColor="#FFE8590C"
            android:pathData="M400,512a112,112 0,1 0,224 0a112,112 0,1 0,-224 0z" />
        <!-- Next: the SVG's stroke, centred on the radius as there. -->
        <path
            android:pathData="M706,512a112,112 0,1 0,224 0a112,112 0,1 0,-224 0z"
            android:strokeColor="#FFA7A9AD"
            android:strokeWidth="26" />
    </group>
</vector>
