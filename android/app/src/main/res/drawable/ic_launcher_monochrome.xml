<?xml version="1.0" encoding="utf-8"?>
<!-- The themed icon (Android 13+): store/appstore/icons/final_tinted.svg,
     iOS's tinted variant, on the foreground's geometry. The launcher keeps
     only the alpha and paints its own colour, so the variant's three greys
     become three alphas — each its grey's luma (#FFFFFF, #B9BABE, #6E7075 →
     FF, BA, 70), roughly how bright iOS's tint draws it. A single alpha would make
     done and today the same dot. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1536"
    android:viewportHeight="1536">
    <group
        android:translateX="256"
        android:translateY="256">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M94,512a112,112 0,1 0,224 0a112,112 0,1 0,-224 0z" />
        <path
            android:fillColor="#BAFFFFFF"
            android:pathData="M400,512a112,112 0,1 0,224 0a112,112 0,1 0,-224 0z" />
        <path
            android:pathData="M706,512a112,112 0,1 0,224 0a112,112 0,1 0,-224 0z"
            android:strokeColor="#70FFFFFF"
            android:strokeWidth="26" />
    </group>
</vector>
