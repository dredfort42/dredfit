<?xml version="1.0" encoding="utf-8"?>
<!-- A planned day in the widget's week strip: iOS's
     `Circle().strokeBorder(Theme.planned, lineWidth: 1.5)` — the stroke
     inside the 14 dp bounds. White, tinted by the widget. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#00000000" />
    <stroke android:width="1.5dp" android:color="#FFFFFFFF" />
    <size android:width="14dp" android:height="14dp" />
</shape>
