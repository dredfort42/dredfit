<?xml version="1.0" encoding="utf-8"?>
<!-- The widget picker's preview on Android 12–14 (`previewLayout`): the
     small size on a workout day, in the person's language and the system's
     mode. Android 15+ shows the generated preview instead — the person's own
     day (widgets/WidgetCenter.kt); Android 10–11 shows the app icon. Static
     views only: the picker inflates this as RemoteViews, with no app code. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_preview_bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/widgets_today_24345a14"
            android:textAllCaps="true"
            android:textColor="@color/widget_preview_ink2"
            android:textSize="11sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot"
            android:tint="@color/widget_preview_accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widgets_workout_day_6012da42"
            android:textColor="@color/widget_preview_ink"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
